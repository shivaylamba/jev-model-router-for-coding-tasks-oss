+export function readConfig(
+  path: string,
+  callback?: ConfigCallback,
+): Promise<Config> | void {
+  const promise = new Promise<Config>((resolve, reject) => {
+    readFile(path, "utf8", (err, text) => {
+      if (err) {
+        reject(err);
+        return;
+      }
+      try {
