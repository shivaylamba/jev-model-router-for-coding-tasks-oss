+    def _grant_pass(self):
+        """Grant the eligible head whose acquire came first; repeat.
+
+        A head is eligible when its bucket has a token and a slot is free.
+        Heads that lack only a slot never sleep; heads that lack a token are
+        served by the sleeper task.
+        """
+        while self._in_use < self._max_concurrent:
+            best = None
+            for state in self._keys.values():
+                if not state.queue:
+                    continue
+                head = state.queue[0]
+                if state.bucket.available() < 1:
+                    continue
+                if best is None or head.seq < best.seq:
+                    best = head
+            if best is None:
+                break
+            best.state.queue.popleft()
+            best.state.bucket.try_take()
+            best.granted = True
+            self._in_use += 1
+            best.event.set()
+        if self._wake is not None:
+            # (Re)schedule the token wait; the sleeper recomputes the delay.
+            self._wake.set()
+
+    async def _sleeper_loop(self):
+        """Performs every sleep() for the limiter, exactly one sleep per wait.
+
+        Sleeps precisely the time until the earliest head's bucket reaches one
+        token (computed from clock() at that moment), then runs a grant pass.
+        Heads that only lack a slot are not waited on here.
+        """
+        wake = self._wake
+        while True:
+            await wake.wait()
+            wake.clear()
+            deadline = None
+            for state in self._keys.values():
+                if not state.queue:
+                    continue
+                wait = state.bucket.time_until_available()
+                if wait <= 0:
+                    # Head already has a token; only a slot could be missing,
+                    # and slot waits are resolved by release/cancellation.
+                    continue
+                need_at = self._clock() + wait
+                if deadline is None or need_at < deadline:
+                    deadline = need_at
+            if deadline is None:
+                continue  # nothing to wait for; park until the next grant pass
+            delay = deadline - self._clock()
+            if delay > 0:
+                # Re-check for new state before committing to the sleep;
+                # _grant_pass() pokes `wake` again if anything changed.
+                await asyncio.sleep(0)
+                if wake.is_set():
+                    continue
+                await self._sleep(delay)
+            self._grant_pass()
