+class ConstructorTest(unittest.TestCase):
+    def test_rejects_bad_args(self):
+        ft = FakeTime()
+        for kwargs in (
+            dict(rate=0),
+            dict(rate=-1),
+            dict(rate="fast"),
+            dict(burst=0),
+            dict(burst=1.5),
+            dict(max_concurrent=0),
+            dict(max_concurrent=2.5),
+        ):
+            base = dict(rate=1.0, burst=1, max_concurrent=1)
+            base.update(kwargs)
+            with self.assertRaises(ValueError, msg=str(kwargs)):
+                RateLimiter(**base, clock=ft.clock, sleep=ft.sleep)
+
+    def test_accepts_valid_args(self):
+        ft = FakeTime()
+        RateLimiter(rate=3, burst=1, max_concurrent=1, clock=ft.clock, sleep=ft.sleep)
+        self.assertTrue(True)  # no error raised
+
