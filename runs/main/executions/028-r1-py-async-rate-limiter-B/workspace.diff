+class GrantPassAcrossKeysTest(unittest.IsolatedAsyncioTestCase):
+    async def test_earliest_caller_with_token_wins(self):
+        # a1 (t=0) holds the only slot; k2 (t=1) is queued before b1 (t=2).
+        # When a1 releases at t=3, b1's bucket has refilled, so b1's request
+        # is also eligible -- but b1 was queued later, so k2 wins.
+        ft = FakeTime()
+        limiter = RateLimiter(rate=1.0, burst=2, max_concurrent=1,
+                              clock=ft.clock, sleep=ft.sleep)
+        done = []
+
+        async def run(key, name, grant=None):
+            if grant is None:
+                grant = await limiter.acquire(key)
+            done.append(name)
+            grant.release()
+
+        g = await limiter.acquire("a")
+        done.append("a1")
+        self.assertEqual(limiter.in_use, 1)
+        await ft.advance(1.0)
+        tk = asyncio.create_task(run("k", "k2"))
+        await settle()
+        await ft.advance(1.0)
+        tb = asyncio.create_task(run("b", "b1"))
+        await settle()
+        self.assertEqual(limiter.waiting(), 2)
+        self.assertEqual(ft.sleep_calls, [])  # token-rich: slot wait, no sleeps
+        await ft.advance(1.0)  # t=3: k2 and b1 both have tokens, slot still held
+        await settle()
+        self.assertEqual(done, ["a1"])
+        g.release()            # grant pass runs synchronously inside release()
+        self.assertEqual(limiter.in_use, 1)   # slot immediately re-granted
+        self.assertEqual(limiter.waiting(), 1)  # one request (b1) still queued
+        await tk
+        await tb
+        self.assertEqual(done, ["a1", "k2", "b1"])
+
