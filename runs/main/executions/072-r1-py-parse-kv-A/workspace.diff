+def parse_kv(text):
+    """Parse a `key=value; key=value` string into a dict of strings.
+
+    Segments are split on ";"; empty segments are skipped. Each segment is
+    split on its first "=" only, keys and values are stripped, and repeated
+    keys keep the last value.
+
+    >>> parse_kv("a=1; b = two")
+    {'a': '1', 'b': 'two'}
+    >>> parse_kv("")
+    {}
+    >>> parse_kv("query=x=1; a=")
+    {'query': 'x=1', 'a': ''}
+    >>> parse_kv("a")
+    Traceback (most recent call last):
+    ...
+    ValueError: segment 'a' has no '='
+    >>> parse_kv(" = 2")
+    Traceback (most recent call last):
+    ...
+    ValueError: segment ' = 2' has an empty key
+    """
+    pairs = {}
+    for segment in text.split(";"):
+        if not segment.strip():
+            continue
+        if "=" not in segment:
+            raise ValueError(f"segment {segment!r} has no '='")
+        key, value = segment.split("=", 1)
+        key = key.strip()
+        if not key:
+            raise ValueError(f"segment {segment!r} has an empty key")
+        pairs[key] = value.strip()
+    return pairs
