+def _flatten(mapping, prefix, out):
+    for key, value in mapping.items():
+        name = f"{prefix}.{key}" if prefix else key
+        if isinstance(value, dict):
+            _flatten(value, name, out)
+        else:
+            if name in out:
+                raise ValueError(f"duplicate column: {name}")
+            out[name] = value
+
+
+def _render(value):
+    if value is None:
+        return ""
+    if isinstance(value, bool):
+        return "true" if value else "false"
+    if isinstance(value, (list, tuple)):
+        return ";".join(_render(item) for item in value)
+    return str(value)
+
+
+def records_to_csv(records):
+    """Render a list of records (as from loader.parse_ndjson) as CSV text.
+
+    Nested dicts flatten into dot-separated column names; columns appear in
+    first-seen order. An empty records list returns "".
+    """
+    if not records:
+        return ""
+    flattened = []
+    columns = []
+    seen = set()
+    for record in records:
+        if not isinstance(record, dict):
+            raise TypeError(f"expected dict, got {type(record).__name__}")
+        row = {}
+        _flatten(record, "", row)
+        for name in row:
+            if name not in seen:
+                seen.add(name)
+                columns.append(name)
+        flattened.append(row)
+    rows = [[_render(row.get(column)) for column in columns] for row in flattened]
+    return rows_to_csv(columns, rows)
