         self.order_id = order_id
         self.items = list(items)
+        self._clock = clock or _utcnow
         self.status = "pending"
         self.tracking_number = None
         self.cancel_reason = None
+        self.delivered_at = None
+        self.history = []
 
     def total_cents(self):
         return sum(quantity * price for _sku, quantity, price in self.items)
 
-    # TODO: none of these check the current status (see docs/ORDER_LIFECYCLE.md).
+    @property
+    def is_terminal(self):
+        return self.status in TERMINAL_STATUSES
+
+    def _refund_window_open(self, now=None):
+        if self.status != "delivered":
+            return True
+        now = self._clock() if now is None else now
+        return now - self.delivered_at <= REFUND_WINDOW
+
+    def can(self, event):
+        """Whether `event` may be fired right now (argument checks excluded)."""
+        entry = TRANSITIONS.get(event)
+        if entry is None:
+            return False
+        from_states, _to = entry
+        if isinstance(from_states, str):
+            from_states = (from_states,)
+        if self.status not in from_states:
+            return False
+        if event == "refund":
+            return self._refund_window_open()
+        return True
+
+    def allowed_events(self):
+        """Event names currently allowed, sorted alphabetically."""
+        return sorted(event for event in TRANSITIONS if self.can(event))
+
+    def _apply(self, event):
+        if not self.can(event):
+            raise InvalidTransition(self.status, event)
+        from_states, to_state = TRANSITIONS[event]
+        now = self._clock()
+        self.history.append(Transition(event, self.status, to_state, now))
+        self.status = to_state
+        return now
