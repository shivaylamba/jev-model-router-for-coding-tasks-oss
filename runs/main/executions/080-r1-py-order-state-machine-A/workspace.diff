 """Orders and their lifecycle."""
 
+from datetime import datetime, timedelta, timezone
+from typing import NamedTuple
+
+REFUND_WINDOW = timedelta(days=30)
+
+TERMINAL_STATUSES = ("cancelled", "refunded")
+
+# Transition table from docs/ORDER_LIFECYCLE.md.
+TRANSITIONS = {
+    "pay": ("pending", "paid"),
+    "pack": ("paid", "packed"),
+    "ship": ("packed", "shipped"),
+    "deliver": ("shipped", "delivered"),
+    "cancel": (("pending", "paid", "packed"), "cancelled"),
+    "refund": (("paid", "packed", "delivered"), "refunded"),
+}
+
+
+class Transition(NamedTuple):
+    event: str
+    from_state: str
+    to_state: str
+    at: datetime
+
+
+class InvalidTransition(Exception):
+    """Raised when an event is not allowed from the order's current status."""
+
+    def __init__(self, state, event):
+        self.state = state
+        self.event = event
+        super().__init__(f"cannot {event} an order in status {state!r}")
+
+
+def _utcnow():
+    return datetime.now(timezone.utc)
+
 
 class Order:
     """A customer order.
 
     `items` is a list of (sku, quantity, unit_price_cents) tuples.
+    `clock` is a zero-argument callable returning the current datetime;
+    every timestamp used by the order comes from it.
     """
 
-    def __init__(self, order_id, items):
