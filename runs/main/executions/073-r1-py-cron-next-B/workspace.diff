+def _parse(expr):
+    """Return (minutes, hours, doms, months, dows, both_restricted).
+
+    The value collections are sorted tuples; `both_restricted` is True when
+    both day fields are restricted, in which case a day matching either one
+    is enough (SPEC.md, "Day of month vs day of week").
+    """
+    text = expr.strip()
+    macro = _MACROS.get(text.lower())
+    if macro is not None:
+        text = macro
+    parts = text.split()
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)} in {expr!r}")
+
+    values = []
+    restricted = []
+    for part, (lo, hi, names) in zip(parts, _FIELDS):
+        field_values, field_restricted = _parse_field(part, lo, hi, names)
+        if names is _WEEKDAYS:
+            field_values = sorted(0 if v == 7 else v for v in field_values)
+        else:
+            field_values = sorted(field_values)
+        values.append(tuple(field_values))
+        restricted.append(field_restricted)
+
+    minutes, hours, doms, months, dows = values
+    return minutes, hours, doms, months, dows, restricted[2] and restricted[4]
+
+
+def _parse_field(field, lo, hi, names):
+    """Parse one field into (set of values, restricted flag)."""
+    values = set()
+    for item in field.split(","):
+        if item == "":
+            raise ValueError(f"empty item in field {field!r}")
+        base, _, step_text = item.partition("/")
+        if _:
+            if not step_text.isdecimal() or int(step_text) == 0:
+                raise ValueError(f"invalid step {step_text!r} in field {field!r}")
+            step = int(step_text)
+        else:
+            step = 1
+        if base == "*":
+            start, end = lo, hi
+        elif "-" in base:
+            start_text, _, end_text = base.partition("-")
+            start = _value(start_text, lo, hi, names, field)
+            end = _value(end_text, lo, hi, names, field)
+            if start > end:
+                raise ValueError(f"reversed range in field {field!r}")
+        else:
+            start = _value(base, lo, hi, names, field)
+            # `N/S` runs from N up to the maximum; bare `N` is just N
+            end = hi if _ else start
+        values.update(range(start, end + 1, step))
+    return values, not field.startswith("*")
+
+
+def _value(text, lo, hi, names, field):
+    """One value: a number or a field name, within the field's range."""
+    if text.isdecimal():
+        value = int(text)
+    elif names is not None:
+        value = names.get(text.lower())
+        if value is None:
+            raise ValueError(f"unknown name {text!r} in field {field!r}")
+    else:
+        raise ValueError(f"expected a number in field {field!r}, got {text!r}")
+    if not lo <= value <= hi:
+        raise ValueError(f"value {text!r} out of range {lo}-{hi} in field {field!r}")
+    return value
+
+
+def _day_matches(day, doms, dows, both_restricted):
+    """Does `day` satisfy the day-of-month/day-of-week rules?"""
+    dom_ok = day.day in doms
+    # cron counts Sunday=0; datetime.weekday() counts Monday=0
+    dow_ok = (day.weekday() + 1) % 7 in dows
+    if both_restricted:
+        return dom_ok or dow_ok
+    return dom_ok and dow_ok
+
+
+def _next_day(day):
+    """The same wall-clock midnight on the following day."""
+    return day + timedelta(days=1)
