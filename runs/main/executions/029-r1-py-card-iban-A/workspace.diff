+def card_brand(number):
+    """Return 'visa', 'mastercard', 'amex' or 'discover' for a valid card number.
+
+    Spaces and hyphens are separators and are ignored; any other non-digit
+    character, a failed Luhn checksum, or an unknown prefix/length returns None.
+    """
+    if not isinstance(number, str):
+        raise TypeError("card number must be a string")
+    digits = strip_separators(number)
+    if not digits or not digits.isdigit() or not luhn_ok(digits):
+        return None
+
+    two = int(digits[:2]) if len(digits) >= 2 else None
+    three = int(digits[:3]) if len(digits) >= 3 else None
+    four = int(digits[:4]) if len(digits) >= 4 else None
+
+    if two in (34, 37) and len(digits) == 15:
+        return "amex"
+    if digits.startswith("4") and len(digits) in (13, 16, 19):
+        return "visa"
+    if (
+        (two is not None and 51 <= two <= 55)
+        or (four is not None and 2221 <= four <= 2720)
+    ) and len(digits) == 16:
+        return "mastercard"
+    if (
+        digits.startswith("6011")
+        or digits.startswith("65")
+        or (three is not None and 644 <= three <= 649)
+    ) and len(digits) in (16, 19):
+        return "discover"
+    return None
+
