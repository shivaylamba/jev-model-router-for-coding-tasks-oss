+def is_valid_iban(iban):
+    """Return True if the IBAN is structurally valid and passes mod-97.
+
+    Spaces are ignored; letters may be in either case. The country must appear
+    in IBAN_LENGTHS with a matching total length, the layout must be two
+    letters, two digits, then letters/digits, and the standard mod-97 check
+    must return 1.
+    """
+    if not isinstance(iban, str):
+        raise TypeError("IBAN must be a string")
+    compact = iban.replace(" ", "").upper()
+    if (
+        len(compact) < 4
+        or not compact[:2].isalpha()
+        or not compact[2:4].isdigit()
+        or not compact.isalnum()
+    ):
+        return False
+    country = compact[:2]
+    if IBAN_LENGTHS.get(country) != len(compact):
+        return False
+
+    rearranged = compact[4:] + compact[:4]
+    numeric = "".join(str(int(ch, 36)) for ch in rearranged)
+    return int(numeric) % 97 == 1
