+def luhn_ok(digits):
+    """Return True if the digit string passes the Luhn checksum."""
+    total = 0
+    for position, ch in enumerate(reversed(digits)):
+        n = int(ch)
+        if position % 2 == 1:
+            n *= 2
+            if n > 9:
+                n -= 9
+        total += n
+    return total % 10 == 0
+
