+
+test("json with a single file still has a total", () => {
+  const io = fakeIo({ "a.txt": "hello world\n" });
+  assert.equal(run(["--json", "a.txt"], io), 0);
+  assert.equal(io.out, '{"files":[{"path":"a.txt","lines":1,"words":2,"chars":12}],"total":{"lines":1,"words":2,"chars":12}}\n');
+});
+
+test("json with several files, the flag in the middle, and a missing file", () => {
+  const io = fakeIo({ "a.txt": "a b\n", "b.txt": "c\n" });
+  assert.equal(run(["a.txt", "--json", "nope.txt", "b.txt"], io), 1);
+  assert.equal(io.out, '{"files":[{"path":"a.txt","lines":1,"words":2,"chars":4},{"path":"b.txt","lines":1,"words":1,"chars":2}],"total":{"lines":2,"words":3,"chars":6}}\n');
+  assert.equal(io.err, "tally: cannot read nope.txt\n");
+});
+
+test("json with no files", () => {
+  const io = fakeIo({});
+  assert.equal(run(["--json"], io), 0);
+  assert.equal(io.out, '{"files":[],"total":{"lines":0,"words":0,"chars":0}}\n');
+});
+
+test("json does not mask unknown options", () => {
+  const io = fakeIo({});
+  assert.equal(run(["--json", "-x"], io), 2);
+  assert.equal(io.out, "");
+});
