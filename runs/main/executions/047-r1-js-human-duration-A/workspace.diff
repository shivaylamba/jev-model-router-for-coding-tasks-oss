+/**
+ * Time units from largest to smallest. `size` is the unit's length in
+ * milliseconds, `abbr` the compact suffix, `name` the long singular name.
+ */
+const UNITS = [
+  { abbr: "d", size: 86_400_000, name: "day" },
+  { abbr: "h", size: 3_600_000, name: "hour" },
+  { abbr: "m", size: 60_000, name: "minute" },
+  { abbr: "s", size: 1_000, name: "second" },
+  { abbr: "ms", size: 1, name: "millisecond" },
+];
+
+const STYLES = new Set(["long", "compact"]);
+
+/**
+ * Format a duration in milliseconds as a readable string, e.g.
+ * "1 hour, 5 minutes" (long) or "1h 5m" (compact).
+ *
+ * The value is floored to whole milliseconds, split into units from largest
+ * to smallest, and at most `units` non-zero units are shown; anything below
+ * the last shown unit is dropped, never rounded. Units smaller than
+ * `smallest` never appear. If nothing would be shown, zero in the `smallest`
+ * unit is returned (e.g. "0 seconds").
+ *
+ * @param {number} ms Non-negative finite duration in milliseconds.
+ * @param {object} [options]
+ * @param {number} [options.units=2] Maximum number of non-zero units to show.
+ * @param {"long"|"compact"} [options.style="long"] Output style.
+ * @param {"d"|"h"|"m"|"s"|"ms"} [options.smallest="s"] Smallest unit allowed.
+ * @returns {string}
+ */
+export function formatDuration(ms, options = {}) {
+  if (typeof ms !== "number") {
+    throw new TypeError(`ms must be a number, got ${typeof ms}`);
+  }
+  if (!Number.isFinite(ms) || ms < 0) {
+    throw new RangeError(`ms must be a non-negative finite number, got ${ms}`);
+  }
+
+  const { units = 2, style = "long", smallest = "s" } = options;
+
+  if (!Number.isInteger(units) || units < 1) {
+    throw new RangeError(`units must be a positive integer, got ${units}`);
+  }
+  if (!STYLES.has(style)) {
+    throw new RangeError(`style must be "long" or "compact", got ${style}`);
+  }
+  const smallestIndex = UNITS.findIndex((u) => u.abbr === smallest);
+  if (smallestIndex === -1) {
+    throw new RangeError(
+      `smallest must be one of "d", "h", "m", "s", "ms", got ${smallest}`,
+    );
+  }
+
+  let remainder = Math.floor(ms);
+  const parts = [];
+  for (let i = 0; i <= smallestIndex && parts.length < units; i++) {
+    const unit = UNITS[i];
+    const count = Math.floor(remainder / unit.size);
+    remainder -= count * unit.size;
+    if (count === 0) continue;
+    parts.push(style === "compact"
+      ? `${count}${unit.abbr}`
+      : `${count} ${unit.name}${count === 1 ? "" : "s"}`);
+  }
+
+  if (parts.length === 0) {
+    const unit = UNITS[smallestIndex];
+    return style === "compact" ? `0${unit.abbr}` : `0 ${unit.name}s`;
+  }
+  return parts.join(style === "compact" ? " " : ", ");
+}
diff --git a/test/duration.test.js b/test/duration.test.js
new file mode 100644
index 0000000..3d4424f
--- /dev/null
+++ b/test/duration.test.js
@@ -0,0 +1,60 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { formatDuration } from "../src/duration.js";
+
+test("defaults: long style, 2 units, smallest second", () => {
+  assert.equal(formatDuration(1500), "1 second");
+  assert.equal(formatDuration(3661000), "1 hour, 1 minute");
+  assert.equal(formatDuration(0), "0 seconds");
+  assert.equal(formatDuration(999), "0 seconds");
+});
+
+test("floors ms before splitting", () => {
+  assert.equal(formatDuration(1500.7), "1 second");
+  assert.equal(formatDuration(59_999.999, { smallest: "ms" }), "59 seconds, 999 milliseconds");
+});
+
+test("skips zero units without counting them", () => {
+  // 1 day + 5 minutes
+  assert.equal(formatDuration(86_700_000), "1 day, 5 minutes");
+  // 2 hours + 3 seconds, hours/minutes/seconds skipped where zero
+  assert.equal(formatDuration(7_203_000), "2 hours, 3 seconds");
+});
+
+test("drops remainder below last shown unit, never rounds", () => {
+  // 59m 59.999s
+  assert.equal(formatDuration(3_599_999), "59 minutes, 59 seconds");
+  assert.equal(formatDuration(3_599_999, { units: 1 }), "59 minutes");
+});
+
+test("singular only when the number is 1", () => {
+  assert.equal(formatDuration(1000), "1 second");
+  assert.equal(formatDuration(2000), "2 seconds");
+  assert.equal(formatDuration(60_000), "1 minute");
+});
+
+test("compact style", () => {
+  assert.equal(formatDuration(3900000, { style: "compact" }), "1h 5m");
+  assert.equal(formatDuration(0, { style: "compact" }), "0s");
+  assert.equal(formatDuration(1500, { style: "compact", smallest: "ms" }), "1s 500ms");
+});
+
+test("smallest unit option", () => {
+  assert.equal(formatDuration(1500, { smallest: "ms" }), "1 second, 500 milliseconds");
+  assert.equal(formatDuration(500, { smallest: "m" }), "0 minutes");
+  assert.equal(formatDuration(500, { smallest: "ms" }), "500 milliseconds");
+  assert.equal(formatDuration(86_400_000, { smallest: "d" }), "1 day");
+  assert.equal(formatDuration(86_399_999, { smallest: "d" }), "0 days");
+});
+
+test("errors", () => {
+  assert.throws(() => formatDuration("1500"), TypeError);
+  assert.throws(() => formatDuration(null), TypeError);
+  assert.throws(() => formatDuration(-1), RangeError);
+  assert.throws(() => formatDuration(NaN), RangeError);
+  assert.throws(() => formatDuration(Infinity), RangeError);
+  assert.throws(() => formatDuration(1000, { units: 0 }), RangeError);
+  assert.throws(() => formatDuration(1000, { units: 2.5 }), RangeError);
+  assert.throws(() => formatDuration(1000, { style: "short" }), RangeError);
+  assert.throws(() => formatDuration(1000, { smallest: "x" }), RangeError);
+});
