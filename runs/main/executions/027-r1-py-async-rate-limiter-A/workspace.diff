+"""Tests for RateLimiter, driven by the FakeTime clock/sleep (no real time)."""
+
+import asyncio
+import unittest
+
+from ratelimit import RateLimiter
+
+from tests.fake_time import FakeTime, settle
+
+
+def make_limiter(rate=2.0, burst=2, max_concurrent=1, start=0.0):
+    fake = FakeTime(start=start)
+    limiter = RateLimiter(
+        rate, burst, max_concurrent, clock=fake.clock, sleep=fake.sleep
+    )
+    return limiter, fake
+
+
+class ConstructorTest(unittest.TestCase):
+    def test_invalid_arguments_raise_value_error(self):
+        fake = FakeTime()
+        bad = [
+            (0, 2, 1),
+            (-1, 2, 1),
+            ("2", 2, 1),
+            (2.0, 0, 1),
+            (2.0, 1.5, 1),
+            (2.0, True, 1),
+            (2.0, 2, 0),
+            (2.0, 2, 1.5),
+        ]
+        for rate, burst, max_concurrent in bad:
+            with self.assertRaises(ValueError, msg=(rate, burst, max_concurrent)):
+                RateLimiter(
+                    rate, burst, max_concurrent, clock=fake.clock, sleep=fake.sleep
+                )
+
+
+class ImmediateGrantTest(unittest.IsolatedAsyncioTestCase):
+    async def test_full_bucket_grants_without_sleep(self):
+        limiter, fake = make_limiter()
+        await limiter.acquire("a")
+        self.assertEqual(limiter.in_use, 1)
+        self.assertEqual(limiter.waiting(), 0)
+        self.assertEqual(fake.sleep_calls, [])  # SPEC: no waiting when not needed
+
+    async def test_grant_consumes_token_and_slot(self):
+        limiter, _ = make_limiter(rate=2.0, burst=2)
+        await limiter.acquire("a")
+        self.assertEqual(limiter.tokens("a"), 1.0)
+
+    async def test_unused_key_reports_full_bucket(self):
+        limiter, _ = make_limiter(burst=3)
+        self.assertEqual(limiter.tokens("never-used"), 3.0)
+        self.assertEqual(limiter.waiting("never-used"), 0)
+
+
+class TokenWaitTest(unittest.IsolatedAsyncioTestCase):
+    async def test_waits_exact_delay_until_next_token(self):
+        # rate=2, burst=2: third request must wait 0.5s for the next token.
+        limiter, fake = make_limiter(rate=2.0, burst=2, max_concurrent=3)
+        await limiter.acquire("a")
+        await limiter.acquire("a")
+        task = asyncio.create_task(limiter.acquire("a"))
+        await settle()
+        self.assertFalse(task.done())
+        self.assertEqual(limiter.waiting("a"), 1)
+        # SPEC: exactly the time until the bucket reaches one token — no polling.
+        self.assertEqual(fake.sleep_calls, [0.5])
+        await fake.advance(0.5)
+        await task
+        self.assertEqual(limiter.in_use, 3)
+        self.assertEqual(limiter.waiting(), 0)
+
+    async def test_sleeps_again_if_clock_fell_short(self):
+        limiter, fake = make_limiter(rate=2.0, burst=1, max_concurrent=2)
+        await limiter.acquire("a")
+        task = asyncio.create_task(limiter.acquire("a"))
+        await settle()
+        self.assertEqual(fake.sleep_calls, [0.5])
+        await fake.advance(0.2)  # wakes the sleeper early, bucket still short
+        self.assertFalse(task.done())
+        await settle()
+        # remaining 0.3 — still no polling with shorter fixed intervals
+        self.assertEqual(fake.sleep_calls, [0.5, 0.3])
+        await fake.advance(0.3)
+        await task
+
+    async def test_tokens_refill_continuously_with_clock(self):
+        limiter, fake = make_limiter(rate=2.0, burst=5, max_concurrent=5)
+        await limiter.acquire("a")
+        await limiter.acquire("a")
+        await fake.advance(1.0)
+        self.assertAlmostEqual(limiter.tokens("a"), 5.0)  # 3 + 2*1.0
+
+
+class SlotWaitTest(unittest.IsolatedAsyncioTestCase):
+    async def test_slot_waiter_does_not_sleep(self):
+        # SPEC: requests that only lack a slot do not sleep.
+        limiter, fake = make_limiter(rate=10, burst=5, max_concurrent=1)
+        await limiter.acquire("a")
+        task = asyncio.create_task(limiter.acquire("b"))
+        await settle()
+        self.assertFalse(task.done())
+        self.assertEqual(limiter.tokens("b"), 5.0)  # token still there
+        self.assertEqual(fake.sleep_calls, [])
+        limiter.release()
+        await task
+        self.assertEqual(limiter.in_use, 1)  # freed slot handed over inside release
+
+    async def test_release_grants_earliest_eligible_caller_across_keys(self):
+        # SPEC grant pass: the slot goes to the earliest caller with a token.
+        limiter, _ = make_limiter(rate=1.0, burst=1, max_concurrent=1)
+        await limiter.acquire("a")  # a empty now, slot held
+        first_b = asyncio.create_task(limiter.acquire("b"))  # has a token
+        await settle()
+        later_a = asyncio.create_task(limiter.acquire("a"))  # out of tokens
+        await settle()
+        limiter.release()
+        await first_b  # b is granted, not the blocked key a
+        self.assertFalse(later_a.done())
+        self.assertEqual(limiter.waiting("a"), 1)
+
+    async def test_release_without_holder_raises(self):
+        limiter, _ = make_limiter()
+        with self.assertRaises(RuntimeError):
+            limiter.release()
+
+
+class FifoPerKeyTest(unittest.IsolatedAsyncioTestCase):
+    async def test_same_key_granted_in_acquire_order(self):
+        # rate=1, burst=1: one token per second for key "a".
+        limiter, fake = make_limiter(rate=1.0, burst=1, max_concurrent=1)
+        await limiter.acquire("a")
+        order = []
+
+        async def request(name):
+            await limiter.acquire("a")
+            order.append(name)
+            limiter.release()
+
+        first = asyncio.create_task(request("first"))
+        await settle()
+        second = asyncio.create_task(request("second"))
+        await settle()
+        self.assertEqual(fake.sleep_calls, [1.0])  # only the head waits on time
+        limiter.release()
+        await settle()  # head re-checks its sleep deadline, then waits again
+        self.assertEqual(fake.sleep_calls, [1.0, 1.0])
+        self.assertEqual(order, [])
+        await fake.advance(1.0)
+        await first
+        self.assertEqual(order, ["first"])
+        await fake.advance(1.0)
+        await second
+        self.assertEqual(order, ["first", "second"])
+
+    async def test_non_head_does_not_consume_token(self):
+        limiter, fake = make_limiter(rate=1.0, burst=1, max_concurrent=2)
+        await limiter.acquire("a")  # bucket empty
+        first = asyncio.create_task(limiter.acquire("a"))
+        await settle()
+        second = asyncio.create_task(limiter.acquire("a"))
+        await settle()
+        self.assertEqual(fake.sleep_calls, [1.0])  # second queues behind, no sleep
+        first.cancel()
+        with self.assertRaises(asyncio.CancelledError):
+            await first
+        second.cancel()
+        with self.assertRaises(asyncio.CancelledError):
+            await second
+
+
+class CrossKeyTest(unittest.IsolatedAsyncioTestCase):
+    async def test_empty_key_never_holds_up_other_keys(self):
+        # SPEC: a key that is out of tokens never holds up other keys.
+        limiter, fake = make_limiter(rate=1.0, burst=1, max_concurrent=2)
+        await limiter.acquire("a")  # a empty, one slot free
+        blocked_a = asyncio.create_task(limiter.acquire("a"))
+        await settle()
+        granted_b = asyncio.create_task(limiter.acquire("b"))
+        await settle()
+        await granted_b  # b has a token and a slot: granted immediately
+        self.assertFalse(blocked_a.done())
+        self.assertEqual(limiter.in_use, 2)
+        blocked_a.cancel()
+        with self.assertRaises(asyncio.CancelledError):
+            await blocked_a
+
+
+class CancellationTest(unittest.IsolatedAsyncioTestCase):
+    async def test_cancelled_waiter_leaves_no_trace(self):
+        limiter, fake = make_limiter(rate=1.0, burst=1, max_concurrent=1)
+        await limiter.acquire("a")  # bucket empty, slot held
+        task = asyncio.create_task(limiter.acquire("a"))
+        await settle()
+        self.assertEqual(limiter.waiting("a"), 1)
+        task.cancel()
+        with self.assertRaises(asyncio.CancelledError):
+            await task
+        self.assertEqual(limiter.waiting("a"), 0)
+        self.assertEqual(limiter.waiting(), 0)
+        self.assertEqual(limiter.in_use, 1)  # it never held a slot
+        await fake.advance(10.0)
+        self.assertEqual(limiter.tokens("a"), 1.0)  # capped at burst, none lost
+
+    async def test_cancelled_head_hands_over_to_next_in_line(self):
+        limiter, fake = make_limiter(rate=1.0, burst=1, max_concurrent=2)
+        await limiter.acquire("a")  # bucket empty
+        head = asyncio.create_task(limiter.acquire("a"))
+        await settle()
+        follower = asyncio.create_task(limiter.acquire("a"))
+        await settle()
+        head.cancel()
+        with self.assertRaises(asyncio.CancelledError):
+            await head
+        await settle()
+        # The follower became the head and started the token wait itself.
+        self.assertEqual(len(fake.sleep_calls), 2)
+        self.assertEqual(fake.sleep_calls[0], 1.0)
+        self.assertEqual(fake.sleep_calls[1], fake.sleep_calls[0])
+        await fake.advance(1.0)
+        await follower
+        self.assertEqual(limiter.in_use, 2)
+
+    async def test_granted_but_cancelled_before_return_undoes_grant(self):
+        # Granted inside release(), cancelled before its task resumed:
+        # slot freed, token back in the bucket (capped at burst).
+        limiter, _ = make_limiter(rate=1.0, burst=1, max_concurrent=1)
+        await limiter.acquire("a")
+        task = TrackedTask(limiter.acquire("b"))
+        await settle()
+        limiter.release()  # grant pass grants b now
+        self.assertEqual(limiter.in_use, 1)  # b holds the slot
+        task.cancel()
+        with self.assertRaises(asyncio.CancelledError):
+            await task
+        self.assertEqual(undo["n"], 1)  # right branch really executed
+        self.assertEqual(limiter.in_use, 0)
+        self.assertEqual(limiter.tokens("b"), 1.0)  # token returned, capped
+
+    async def test_undo_triggers_grant_pass_for_next_eligible(self):
+        limiter, _ = make_limiter(rate=10.0, burst=3, max_concurrent=1)
+        await limiter.acquire("a")
+        waiting_b = TrackedTask(limiter.acquire("b"))
+        await settle()
+        limiter.release()
+        self.assertEqual(limiter.in_use, 1)  # b granted
+        waiting_c = TrackedTask(limiter.acquire("c"))
+        await settle()
+        waiting_b.cancel()  # undo b's grant — next pass must reach c
+        with self.assertRaises(asyncio.CancelledError):
+            await waiting_b
+        self.assertEqual(waiting_b.undo_seen, 1)
+        self.assertEqual(limiter.in_use, 1)  # c took the freed slot
+        await waiting_c
+
+
+class LimitContextTest(unittest.IsolatedAsyncioTestCase):
+    async def test_acquires_on_entry_releases_on_exit(self):
+        limiter, _ = make_limiter()
+        async with limiter.limit("a") as held:
+            self.assertIs(held, limiter)
+            self.assertEqual(limiter.in_use, 1)
