+    def test_add_tag_does_not_leak_to_other_notes(self):
+        a = create_note("a")
+        b = create_note("b")
+        add_tag(a, "work")
+        self.assertEqual(b["tags"], [])
+        self.assertEqual(tag_counts([a, b]), {"work": 1})
+
+    def test_tags_argument_is_not_modified(self):
+        shared = ["Home", "Errands"]
+        first = create_note("n1", tags=shared, pinned=True)
+        second = create_note("n2", tags=shared)
+        self.assertEqual(shared, ["Home", "Errands"])
+        self.assertEqual(first["tags"], ["home", "errands", "pinned"])
+        self.assertEqual(second["tags"], ["home", "errands"])
+        self.assertIsNot(first["tags"], second["tags"])
+
+    def test_tags_accepts_tuple(self):
