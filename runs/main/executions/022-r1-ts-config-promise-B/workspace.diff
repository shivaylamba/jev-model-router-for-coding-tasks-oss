@@ -39,22 +39,23 @@ export function applyDefaults(raw: unknown): Config {
 /**
  * Read and validate a JSON config file.
  *
- * Errors from the file system (for example ENOENT), a SyntaxError for
- * malformed JSON, or a ConfigError for bad values are passed to the callback.
+ * Without a callback, returns a promise that resolves with the config, or
+ * rejects with the file-system error as-is (for example ENOENT), a
+ * SyntaxError for malformed JSON, or a ConfigError for bad values.
+ *
+ * With a callback, those same errors are passed to the callback as the
+ * first argument — exactly once — and readConfig returns undefined.
  */
-export function readConfig(path: string, callback: ConfigCallback): void {
-  readFile(path, "utf8", (err, text) => {
-    if (err) {
-      callback(err);
-      return;
-    }
-    let config: Config;
-    try {
