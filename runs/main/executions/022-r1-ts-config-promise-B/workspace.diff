-    } catch (parseErr) {
-      callback(parseErr as Error);
-      return;
-    }
-    callback(null, config);
-  });
+export function readConfig(path: string): Promise<Config>;
+export function readConfig(path: string, callback: ConfigCallback): undefined;
+export function readConfig(path: string, callback?: ConfigCallback): Promise<Config> | undefined {
+  const promise = readFile(path, "utf8").then((text) => applyDefaults(JSON.parse(text)));
+  if (callback === undefined) {
+    return promise;
+  }
+  promise.then(
+    (config) => callback(null, config),
+    (err: Error) => callback(err),
