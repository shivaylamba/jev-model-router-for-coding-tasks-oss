     def total_cents(self):
         return sum(quantity * price for _sku, quantity, price in self.items)
 
-    # TODO: none of these check the current status (see docs/ORDER_LIFECYCLE.md).
+    @property
+    def is_terminal(self):
+        return self.status in _TERMINAL_STATUSES
+
+    def can(self, event):
+        """Whether `event` is allowed right now, ignoring ship/cancel arguments."""
+        return self._next_state(event) is not None
+
+    def allowed_events(self):
+        """The event names allowed right now, sorted alphabetically."""
+        return sorted(
+            event
+            for event, from_state in _TRANSITIONS
+            if from_state == self.status and self.can(event)
+        )
+
+    # Each lifecycle method checks the transition table first (InvalidTransition),
+    # then its arguments (ValueError). A call that raises changes nothing.
 
     def pay(self):
-        self.status = "paid"
+        self._fire("pay")
 
     def pack(self):
-        self.status = "packed"
+        self._fire("pack")
 
     def ship(self, tracking_number):
-        self.tracking_number = tracking_number
-        self.status = "shipped"
+        to_state = self._require_transition("ship")
+        tracking_number = _required_text("tracking number", tracking_number)
+        self._commit("ship", to_state, tracking_number=tracking_number)
 
     def deliver(self):
-        self.status = "delivered"
+        self._fire("deliver")
 
     def cancel(self, reason):
-        self.cancel_reason = reason
-        self.status = "cancelled"
+        to_state = self._require_transition("cancel")
+        reason = _required_text("reason", reason)
+        self._commit("cancel", to_state, cancel_reason=reason)
 
     def refund(self):
-        self.status = "refunded"
+        self._fire("refund")
+
+    def _next_state(self, event):
+        """The status `event` would move to, or None if it is not allowed."""
+        to_state = _TRANSITIONS.get((event, self.status))
+        if (
+            to_state is not None
+            and event == "refund"
+            and self.status == "delivered"
+            and self._clock() - self.delivered_at > _REFUND_WINDOW
+        ):
+            return None
+        return to_state
+
+    def _require_transition(self, event):
+        to_state = self._next_state(event)
+        if to_state is None:
+            raise InvalidTransition(self.status, event)
+        return to_state
+
+    def _fire(self, event):
+        self._commit(event, self._require_transition(event))
+
+    def _commit(self, event, to_state, **attributes):
+        # Everything that can raise happens before the first mutation.
+        at = self._clock()
+        if event == "deliver":
+            self.delivered_at = at
+        for name, value in attributes.items():
+            setattr(self, name, value)
+        self.history.append(Transition(event, self.status, to_state, at))
+        self.status = to_state
