 """Orders and their lifecycle."""
 
+from datetime import datetime, timedelta, timezone
+from typing import NamedTuple
+
+
+class Transition(NamedTuple):
+    """One successful lifecycle event, as recorded in `Order.history`."""
+
+    event: str
+    from_state: str
+    to_state: str
+    at: datetime
+
+
+class InvalidTransition(Exception):
+    """An event that is not allowed from the order's current status."""
+
+    def __init__(self, state, event):
+        super().__init__(f"cannot {event} an order in {state}")
+        self.state = state
+        self.event = event
+
+
+# (event, from_status) -> to_status, per docs/ORDER_LIFECYCLE.md.
+_TRANSITIONS = {
+    ("pay", "pending"): "paid",
+    ("pack", "paid"): "packed",
+    ("ship", "packed"): "shipped",
+    ("deliver", "shipped"): "delivered",
+    ("cancel", "pending"): "cancelled",
+    ("cancel", "paid"): "cancelled",
+    ("cancel", "packed"): "cancelled",
+    ("refund", "paid"): "refunded",
+    ("refund", "packed"): "refunded",
+    ("refund", "delivered"): "refunded",
+}
+
+_TERMINAL_STATUSES = frozenset({"cancelled", "refunded"})
+_REFUND_WINDOW = timedelta(days=30)
+
+
+def _utcnow():
+    return datetime.now(timezone.utc)
+
+
+def _required_text(label, value):
+    """Reject non-strings and empty or whitespace-only strings."""
+    if not isinstance(value, str) or not value.strip():
+        raise ValueError(f"{label} must be a non-empty string")
+    return value.strip()
+
 
