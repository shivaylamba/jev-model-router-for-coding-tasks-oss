+import base64
+import binascii
+import json
+import warnings
+from dataclasses import dataclass
+from typing import List, Optional
+
+from .errors import InvalidCursorError, ValidationError
+from .store import Article, STATUSES
 
 MAX_PER_PAGE = 100
 
+_CURSOR_PREFIX = "v1."
+
+
+@dataclass
+class Page:
+    """One cursor-paginated page of articles."""
+
+    items: List[Article]
+    next_cursor: Optional[str]
+
+
+def _encode_cursor(published_at, article_id, author, status):
+    payload = json.dumps(
+        {"p": published_at, "i": article_id, "a": author, "s": status},
+        separators=(",", ":"),
+    ).encode("utf-8")
+    return _CURSOR_PREFIX + base64.urlsafe_b64encode(payload).decode("ascii").rstrip("=")
+
+
+def _decode_cursor(raw):
+    """Parse an opaque cursor; anything that is not one of ours raises."""
+    try:
+        if not raw.startswith(_CURSOR_PREFIX):
+            raise InvalidCursorError("cursor is not a valid cursor")
+        body = raw[len(_CURSOR_PREFIX):]
+        body += "=" * (-len(body) % 4)
+        payload = json.loads(base64.urlsafe_b64decode(body.encode("ascii")))
+        if (
+            not isinstance(payload, dict)
+            or not isinstance(payload["p"], int)
+            or not isinstance(payload["i"], int)
+            or not (payload["a"] is None or isinstance(payload["a"], str))
+            or not (payload["s"] is None or isinstance(payload["s"], str))
+        ):
+            raise InvalidCursorError("cursor is not a valid cursor")
+        return payload
+    except InvalidCursorError:
+        raise
+    except (binascii.Error, UnicodeDecodeError, ValueError, KeyError, TypeError):
+        raise InvalidCursorError("cursor is not a valid cursor")
+
 
