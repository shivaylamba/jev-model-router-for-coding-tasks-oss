+from .errors import InvalidCursorError, ValidationError
 from .store import STATUSES
 
 MAX_PER_PAGE = 100
 
+_CURSOR_RE = re.compile(r"[A-Za-z0-9_-]+")
+_CURSOR_VERSION = 1
+
+
+@dataclass
+class Page:
+    """One page of the listing; `next_cursor` continues it, or is None at the end."""
+
+    items: list
+    next_cursor: str | None
+
+
+def _encode_cursor(published_at, article_id, author, status):
+    """Opaque cursor for a listing position and the filters it belongs to."""
+    payload = {
+        "version": _CURSOR_VERSION,
+        "published_at": published_at,
+        "id": article_id,
+        "author": author,
+        "status": status,
+    }
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode("ascii")
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _decode_cursor(cursor):
+    """Return ((published_at, id), author, status) for a cursor from `list_articles`.
+
+    Raises InvalidCursorError for anything else, including strings that decode
+    as base64 or JSON but are not a cursor we produced.
+    """
+    if not isinstance(cursor, str) or not _CURSOR_RE.fullmatch(cursor):
+        raise InvalidCursorError("cursor is not a valid cursor")
+    padded = cursor + "=" * (-len(cursor) % 4)
+    try:
+        payload = json.loads(base64.urlsafe_b64decode(padded.encode("ascii")))
+    except (ValueError, RecursionError):  # bad base64, bad JSON, or pathologically nested JSON
+        raise InvalidCursorError("cursor is not a valid cursor") from None
+    if not isinstance(payload, dict) or not _is_int(payload.get("version")) or payload["version"] != _CURSOR_VERSION:
+        raise InvalidCursorError("cursor is not a valid cursor")
+    if not _is_int(payload.get("published_at")) or not _is_int(payload.get("id")):
+        raise InvalidCursorError("cursor is not a valid cursor")
+    author = payload.get("author")
+    status = payload.get("status")
+    if author is not None and not isinstance(author, str):
+        raise InvalidCursorError("cursor is not a valid cursor")
+    if status is not None and status not in STATUSES:
+        raise InvalidCursorError("cursor is not a valid cursor")
+    position = (payload["published_at"], payload["id"])
+    return position, author, status
+
 
