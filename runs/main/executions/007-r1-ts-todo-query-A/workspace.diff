@@ -11,6 +12,27 @@ export function handleTodos(service: TodoService, url: string): Response {
   if (parsed.pathname !== "/todos") {
     return { status: 404, body: { error: "not found" } };
   }
-  const items = service.list();
-  return { status: 200, body: { items, count: items.length } };
+
+  const params = parsed.searchParams;
+
+  // Build a TodoQuery only from parameters that are present; unknown
+  // parameters are ignored and an absent parameter means "use the default".
+  const query: TodoQuery = {};
