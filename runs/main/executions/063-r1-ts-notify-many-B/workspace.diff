--- a/src/notifier.ts
+++ b/src/notifier.ts
@@ -19,14 +19,31 @@ export class Notifier {
   }
 
   /**
-   * Send `message` to one recipient. The recipient is trimmed before sending.
-   * Throws TypeError if the recipient is empty or only whitespace.
+   * Send `message` to one recipient or a list of recipients, in the order given.
+   * Each recipient is trimmed before sending. Duplicates are sent only once:
+   * recipients match case-insensitively after trimming, and the first spelling
+   * is the one that gets sent. Returns how many messages were actually sent
+   * (1 for a single string, 0 for an empty list).
+   * Throws TypeError if any recipient is empty or only whitespace, and does so
+   * before sending anything — a bad list never results in a partial send.
    */
-  notify(recipient: string, message: string): void {
-    const to = recipient.trim();
-    if (to === "") {
-      throw new TypeError("recipient must be a non-empty string");
+  notify(recipients: string | readonly string[], message: string): number {
+    const list = typeof recipients === "string" ? [recipients] : recipients;
+    const trimmed = list.map((recipient) => recipient.trim());
+    for (const to of trimmed) {
+      if (to === "") {
+        throw new TypeError("recipient must be a non-empty string");
+      }
     }
-    this.transport.send(to, message);
+    const seen = new Set<string>();
+    let sent = 0;
+    for (const to of trimmed) {
+      const key = to.toLowerCase();
+      if (seen.has(key)) continue;
+      seen.add(key);
+      this.transport.send(to, message);
+      sent++;
+    }
+    return sent;
   }
 }
