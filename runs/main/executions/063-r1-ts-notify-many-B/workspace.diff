+test("notify sends to each recipient in order", () => {
+  const transport = new MemoryTransport();
+  const sent = new Notifier(transport).notify(["  a@example.com ", "b@example.com"], "hi");
+  assert.equal(sent, 2);
+  assert.deepEqual(transport.sent, [
+    { recipient: "a@example.com", message: "hi" },
+    { recipient: "b@example.com", message: "hi" },
+  ]);
+});
+
+test("notify returns 1 for a single string recipient", () => {
+  const transport = new MemoryTransport();
+  assert.equal(new Notifier(transport).notify("a@example.com", "hi"), 1);
+});
+
+test("notify sends an empty list nowhere", () => {
+  const transport = new MemoryTransport();
+  assert.equal(new Notifier(transport).notify([], "hi"), 0);
+  assert.deepEqual(transport.sent, []);
+});
+
+test("notify skips duplicates case-insensitively, keeping the first spelling", () => {
+  const transport = new MemoryTransport();
+  const sent = new Notifier(transport).notify(["Ops@Example.com", "  ops@example.com", "OPS@EXAMPLE.COM"], "hi");
+  assert.equal(sent, 1);
+  assert.deepEqual(transport.sent, [{ recipient: "Ops@Example.com", message: "hi" }]);
+});
+
+test("blank recipient in a list is rejected before anything is sent", () => {
+  const transport = new MemoryTransport();
+  assert.throws(() => new Notifier(transport).notify(["a@example.com", "  "], "hi"), TypeError);
+  assert.deepEqual(transport.sent, []);
+});
+
