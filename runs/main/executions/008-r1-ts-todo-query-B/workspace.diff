+/** Query parameters for {@link TodoService.query}. See docs/query.md. */
+export interface TodoQuery {
+  /** Filter by status; default "all". */
+  status?: "open" | "done" | "all";
+  /** Todo must carry every listed tag (case-insensitive); empty/absent = no filter. */
+  tags?: string[];
+  /** Case-insensitive substring on title; trimmed, empty = no filter. */
+  text?: string;
+  /** Keep todos due on or before this "YYYY-MM-DD" date; undated todos never match. */
+  dueBefore?: string;
+  /** Sort key; default "id". */
+  sort?: "id" | "created" | "due" | "title";
+  /** Sort order; default "asc". */
+  order?: "asc" | "desc";
+}
+
+/** Whether `value` is a real calendar date written strictly as "YYYY-MM-DD". */
+function isValidDueBefore(value: string): boolean {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+  const [y, m, d] = value.split("-").map((p) => parseInt(p, 10));
+  const date = new Date(Date.UTC(y, m - 1, d));
+  return (
+    date.getUTCFullYear() === y &&
+    date.getUTCMonth() === m - 1 &&
+    date.getUTCDate() === d
+  );
+}
+
+const STATUS_VALUES = ["open", "done", "all"] as const;
+const SORT_VALUES = ["id", "created", "due", "title"] as const;
+const ORDER_VALUES = ["asc", "desc"] as const;
+
+/**
+ * Validate a TodoQuery, throwing RangeError for any out-of-spec value.
+ * Returns the normalized (non-undefined) status / sort / order.
+ */
+export function validateTodoQuery(query: TodoQuery): {
+  status: "open" | "done" | "all";
+  sort: "id" | "created" | "due" | "title";
+  order: "asc" | "desc";
+} {
+  const status = query.status ?? "all";
+  const sort = query.sort ?? "id";
+  const order = query.order ?? "asc";
+  if (!STATUS_VALUES.includes(status as (typeof STATUS_VALUES)[number])) {
+    throw new RangeError(`status 必须是 open、done 或 all，收到：${String(query.status)}`);
+  }
+  if (!SORT_VALUES.includes(sort as (typeof SORT_VALUES)[number])) {
+    throw new RangeError(`sort 必须是 id、created、due 或 title，收到：${String(query.sort)}`);
+  }
+  if (!ORDER_VALUES.includes(order as (typeof ORDER_VALUES)[number])) {
+    throw new RangeError(`order 必须是 asc 或 desc，收到：${String(query.order)}`);
+  }
+  if (query.dueBefore !== undefined && !isValidDueBefore(query.dueBefore)) {
+    throw new RangeError(`dueBefore 必须是合法的 YYYY-MM-DD 日历日期，收到：${query.dueBefore}`);
+  }
+  return { status: status as "open" | "done" | "all", sort: sort as "id" | "created" | "due" | "title", order: order as "asc" | "desc" };
+}
