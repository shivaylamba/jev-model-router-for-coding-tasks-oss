+    def _expire_stale_holds(self):
+        """Lazily flip any ``"held"`` hold whose time is up to ``"expired"``.
+
+        Expiry should be observable the instant the clock reaches the hold's
+        expiry — no background sweep required — so every read path goes
+        through this.
+        """
+        now = self._clock.now()
+        changed = False
+        for hold in self._holds.all():
+            if hold.status == "held" and hold.is_expired(now):
+                hold.status = "expired"
+                changed = True
+        if changed:
+            self._sync_reserved()
+        return changed
+
+    def _sync_reserved(self):
+        """Rebuild reserved counters from the hold statuses in the store.
+
+        Keeping the counters derived (rather than maintained incrementally)
+        means they can never drift, no matter how many times a hold is
+        touched after it has left the ``"held"`` state.
+        """
+        self._reserved.clear()
+        for hold in self._holds.all():
+            if hold.status == "held":
+                self._reserved[hold.sku] += hold.quantity
+
     def available(self, sku):
