+// Code point ranges that occupy two terminal columns (see SPEC.md).
+const WIDE_RANGES: ReadonlyArray<readonly [number, number]> = [
+  [0x1100, 0x115f],
+  [0x2e80, 0x303e],
+  [0x3041, 0x33ff],
+  [0x3400, 0x4dbf],
+  [0x4e00, 0x9fff],
+  [0xa000, 0xa4cf],
+  [0xac00, 0xd7a3],
+  [0xf900, 0xfaff],
+  [0xfe30, 0xfe4f],
+  [0xff00, 0xff60],
+  [0xffe0, 0xffe6],
+  [0x1f300, 0x1f64f],
+  [0x1f900, 0x1f9ff],
+  [0x20000, 0x3fffd],
+];
+
+function isWide(codePoint: number): boolean {
+  for (const [lo, hi] of WIDE_RANGES) {
+    if (codePoint >= lo && codePoint <= hi) return true;
+  }
+  return false;
+}
+
+/** Terminal-column width of a string, measured per Unicode code point. */
+function displayWidth(text: string): number {
+  let width = 0;
+  for (const char of text) {
+    width += isWide(char.codePointAt(0)!) ? 2 : 1;
+  }
+  return width;
+}
+
+/** Split a cell into paragraphs, each paragraph into non-empty words. */
+function splitParagraphs(cell: string): string[][] {
+  return cell
+    .split("\n")
+    .map((paragraph) => paragraph.split(" ").filter((word) => word.length > 0));
+}
+
+/**
+ * The longest prefix of `word` (in whole code points) whose display width
+ * is at most `width`. By the spec's minimum-width rule, the first code point
+ * always fits, so the result is never empty.
+ */
+function fittingPrefix(word: string, width: number): string {
+  let result = "";
+  let used = 0;
+  for (const char of word) {
+    const charWidth = isWide(char.codePointAt(0)!) ? 2 : 1;
+    if (used + charWidth > width) break;
+    result += char;
+    used += charWidth;
+  }
+  if (result === "") {
+    // Degenerate case (width smaller than the first code point): keep the
+    // first code point whole rather than splitting a surrogate pair.
+    result = Array.from(word)[0]!;
+  }
+  return result;
+}
+
+/** Greedily wrap one paragraph to a column width; an empty word list yields one empty line. */
+function wrapParagraph(words: string[], width: number): string[] {
+  const lines: string[] = [];
+  let current = "";
+  const finish = () => {
+    lines.push(current);
+    current = "";
+  };
+  for (const word of words) {
+    const wordWidth = displayWidth(word);
+    const candidate = current === "" ? word : `${current} ${word}`;
+    if (displayWidth(candidate) <= width) {
+      current = candidate;
+    } else if (wordWidth <= width) {
+      if (current !== "") finish();
+      current = word;
+    } else {
+      if (current !== "") finish();
+      let rest = word;
+      while (displayWidth(rest) > width) {
+        const piece = fittingPrefix(rest, width);
+        lines.push(piece);
+        rest = rest.slice(piece.length);
+      }
+      current = rest;
+    }
+  }
+  finish();
+  return lines;
+}
+
+/** Pad a line to exactly the column width according to its alignment. */
+function pad(line: string, width: number, align: Align): string {
+  const extra = width - displayWidth(line);
+  if (extra <= 0) return line;
+  if (align === "right") return " ".repeat(extra) + line;
+  if (align === "center") {
+    const before = Math.floor(extra / 2);
+    return " ".repeat(before) + line + " ".repeat(extra - before);
+  }
+  return line + " ".repeat(extra);
+}
+
 export function renderTable(rows: string[][], options: TableOptions = {}): string {
-  throw new Error("renderTable is not implemented yet");
+  const { maxWidth, align, header } = options;
