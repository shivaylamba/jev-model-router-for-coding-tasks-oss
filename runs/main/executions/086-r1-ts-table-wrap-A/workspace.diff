+      let target = -1;
+      for (let column = 0; column < widths.length; column++) {
+        if (widths[column] <= minWidths[column]) continue;
+        // `>=` keeps the rightmost column among those tied for widest.
+        if (target === -1 || widths[column] >= widths[target]) target = column;
+      }
+      if (target === -1) {
+        throw new RangeError("table cannot be made to fit within maxWidth");
+      }
+      widths[target]--;
+    }
+  }
+
+  const alignOf = (column: number): Align => (align && align[column]) || "left";
+
+  const wrappedCells: string[][][] = rows.map((row) => {
+    const wrapped: string[][] = [];
+    for (let column = 0; column < columnCount; column++) {
+      const cell = column < row.length ? row[column] : "";
+      const lines: string[] = [];
+      for (const words of splitParagraphs(cell)) {
+        lines.push(...wrapParagraph(words, widths[column]));
+      }
+      wrapped.push(lines);
+    }
+    return wrapped;
+  });
+
+  const lines: string[] = [];
+  wrappedCells.forEach((wrapped, rowIndex) => {
+    const height = Math.max(...wrapped.map((cellLines) => cellLines.length));
+    for (let lineIndex = 0; lineIndex < height; lineIndex++) {
+      const parts: string[] = [];
+      for (let column = 0; column < columnCount; column++) {
+        const line = wrapped[column][lineIndex] ?? "";
+        parts.push(pad(line, widths[column], alignOf(column)));
+      }
+      lines.push(parts.join(" | "));
+    }
+    if (header && rowIndex === 0) {
+      lines.push(widths.map((w) => "-".repeat(w)).join("-+-"));
+    }
+  });
+
+  return lines.join("\n");
 }
