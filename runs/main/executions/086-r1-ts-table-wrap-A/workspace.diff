+  if (maxWidth !== undefined) {
+    if (!Number.isInteger(maxWidth) || maxWidth <= 0) {
+      throw new RangeError("maxWidth must be a positive integer");
+    }
+  }
+  if (align !== undefined) {
+    for (const entry of align) {
+      if (entry !== "left" && entry !== "right" && entry !== "center") {
+        throw new RangeError(`invalid alignment: ${String(entry)}`);
+      }
+    }
+  }
+
+  const columnCount = rows.reduce((max, row) => Math.max(max, row.length), 0);
+  if (columnCount === 0) return "";
+
+  // Shorter rows behave as if missing cells were empty strings.
+  const cellsOf = (column: number): string[] =>
+    rows.map((row) => (column < row.length ? row[column] : ""));
+
+  const minWidths: number[] = [];
