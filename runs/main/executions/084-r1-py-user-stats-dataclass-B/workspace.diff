 """Per-user activity statistics."""
 
+from dataclasses import dataclass
+from datetime import datetime
+
+
+@dataclass(frozen=True)
+class UserStats:
+    """One user's activity summary.
+
+    The fields are in tuple order (total_events, active_days, last_seen),
+    and an instance still behaves like that 3-tuple for code predating
+    this class: it unpacks into the three values, tuple() converts to
+    them, len() is 3, and integer indexing (negative included) works,
+    raising IndexError past the end. last_seen is None when the user has
+    no events.
+    """
+
+    total_events: int
+    active_days: int
+    last_seen: datetime | None
+
+    @property
+    def events_per_active_day(self):
+        """Mean events per active day; 0.0 when there are no active days."""
+        if self.active_days == 0:
+            return 0.0
+        return self.total_events / self.active_days
+
+    def as_dict(self):
+        """The three fields as a dict, keyed by field name."""
+        return {
+            "total_events": self.total_events,
+            "active_days": self.active_days,
+            "last_seen": self.last_seen,
+        }
+
+    # Tuple compatibility, field order above:
+
+    def __iter__(self):
+        return iter((self.total_events, self.active_days, self.last_seen))
+
+    def __len__(self):
+        return 3
+
+    def __getitem__(self, index):
+        return (self.total_events, self.active_days, self.last_seen)[index]
+
 
