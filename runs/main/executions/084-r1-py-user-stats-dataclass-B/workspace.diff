+    def test_behaves_like_tuple(self):
+        stats = get_user_stats(EVENTS, "ana")
+        self.assertEqual(tuple(stats), (3, 2, at(3)))
+        self.assertEqual(len(stats), 3)
+        self.assertEqual(stats[0], 3)
+        self.assertEqual(stats[2], at(3))
+        self.assertEqual(stats[-1], at(3))
+        with self.assertRaises(IndexError):
+            stats[3]
+
+    def test_frozen(self):
+        stats = get_user_stats(EVENTS, "ana")
+        with self.assertRaises(FrozenInstanceError):
