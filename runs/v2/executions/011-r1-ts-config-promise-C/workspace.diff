+export function readConfig(path: string, callback?: ConfigCallback): Promise<Config> | void {
+  if (callback) {
+    readFile(path, "utf8", (err, text) => {
+      if (err) {
+        callback(err);
+        return;
+      }
+      let config: Config;
+      try {
+        config = applyDefaults(JSON.parse(text));
+      } catch (parseErr) {
+        callback(parseErr as Error);
+        return;
+      }
+      callback(null, config);
+    });
+    return;
+  }
+
+  return new Promise((resolve, reject) => {
+    readFile(path, "utf8", (err, text) => {
+      if (err) {
+        reject(err);
+        return;
+      }
+      try {
+        resolve(applyDefaults(JSON.parse(text)));
+      } catch (parseErr) {
+        reject(parseErr);
+      }
