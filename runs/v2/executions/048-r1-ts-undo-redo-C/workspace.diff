+// Undo / Redo API
+test("undo restores text and selection", () => {
+  const editor = new Editor("hello");
+  editor.select(5);
+  editor.insert(" world");
+  assert.equal(editor.text, "hello world");
+  const didUndo = editor.undo();
+  assert.equal(didUndo, true);
+  assert.equal(editor.text, "hello");
+  assert.deepEqual(editor.selection, { start: 5, end: 5 });
+});
+
+test("redo restores text and selection after undo", () => {
+  const editor = new Editor("hello");
+  editor.select(5);
+  editor.insert(" world");
+  editor.undo();
+  const didRedo = editor.redo();
+  assert.equal(didRedo, true);
+  assert.equal(editor.text, "hello world");
+  assert.deepEqual(editor.selection, { start: 11, end: 11 });
+});
+
+test("undo returns false when nothing to undo", () => {
