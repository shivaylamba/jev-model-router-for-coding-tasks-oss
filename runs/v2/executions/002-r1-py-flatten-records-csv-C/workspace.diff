+
+    def test_cross_record_collision_merges(self):
+        records = [{"a.b": 1}, {"a": {"b": 2}}]
+        self.assertEqual(records_to_csv(records), 'a.b\r\n1\r\n2\r\n')
+
+    def test_non_dict_record(self):
