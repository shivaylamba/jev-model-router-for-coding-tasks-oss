+class RecordsToCsvTest(unittest.TestCase):
+    def test_empty_records(self):
+        self.assertEqual(records_to_csv([]), "")
+
+    def test_flatten_nested_dicts(self):
+        records = [
+            {"user": {"name": "ada", "id": 1}, "action": "login"},
+            {"user": {"name": "bob"}},
+        ]
+        self.assertEqual(
+            records_to_csv(records),
+            'user.name,user.id,action\r\nada,1,login\r\nbob,,\r\n',
+        )
+
+    def test_scalar_cells(self):
+        records = [{"flags": [True, None, 2], "empty": [], "n": None, "b": False}]
+        self.assertEqual(
+            records_to_csv(records),
+            'flags,empty,n,b\r\ntrue;;2,,,false\r\n',
+        )
+
+    def test_value_and_dict_for_same_key(self):
+        records = [{"a": 5}, {"a": {"b": 1}}]
+        self.assertEqual(records_to_csv(records), 'a,a.b\r\n5,\r\n,1\r\n')
+
+    def test_nested_empty_dict_contributes_no_column(self):
+        records = [{"a": {"b": {}}, "c": 1}]
+        self.assertEqual(records_to_csv(records), 'c\r\n1\r\n')
+
+    def test_quoting(self):
+        records = [{"a": "x,y"}, {"a": 'say "hi"'}]
+        self.assertEqual(
+            records_to_csv(records),
+            'a\r\n"x,y"\r\n"say ""hi"""\r\n',
+        )
+
+    def test_same_record_collision(self):
