 """Per-user activity statistics."""
 
+from dataclasses import dataclass
+from datetime import datetime
+
+
+@dataclass(frozen=True)
+class UserStats:
+    """A user's activity summary.
+
+    Behaves like a tuple `(total_events, active_days, last_seen)` for
+    unpacking, `len`, and integer indexing, so existing callers that treat the
+    result as a tuple keep working.
+    """
+
+    total_events: int
+    active_days: int
+    last_seen: datetime | None
+
+    @property
+    def events_per_active_day(self):
+        """Average events per active day, or 0.0 when there were no active days."""
+        if self.active_days == 0:
+            return 0.0
+        return self.total_events / self.active_days
+
+    def as_dict(self):
+        return {
+            "total_events": self.total_events,
+            "active_days": self.active_days,
+            "last_seen": self.last_seen,
+        }
+
+    def __iter__(self):
+        return iter((self.total_events, self.active_days, self.last_seen))
+
+    def __len__(self):
+        return 3
+
+    def __getitem__(self, index):
+        return (self.total_events, self.active_days, self.last_seen)[index]
+
 
