diff --git a/src/clock.ts b/src/clock.ts
index e742cdb..430c50a 100644
--- a/src/clock.ts
+++ b/src/clock.ts
@@ -9,3 +9,41 @@ export function formatClock(minutes: number): string {
   const mins = minutes % 60;
   return `${String(hours).padStart(2, "0")}:${String(mins).padStart(2, "0")}`;
 }
+
+// 12-hour: hour (1-12), optional ":MM", optional space, then am/pm (any case),
+// e.g. "7:30 pm", "7pm", "9 Am". Groups: [1]=hour [2]=MM(optional) [3]=meridian.
+const AMPM_RE = /^(\d{1,2})(?::(\d{2}))?\s*([ap]m)$/i;
+// 24-hour: hour (0-23) ":" MM (exactly two digits). Groups: [1]=hour [2]=minute.
+const H24_RE = /^(\d{1,2}):(\d{2})$/;
+
+/** Parse a clock time as minutes after midnight. Accepts 24-hour "H:MM" and
+ * 12-hour "H[:MM] am|pm" forms (ignoring surrounding whitespace and letter
+ * case). Throws RangeError for an out-of-range number and SyntaxError for any
+ * text that doesn't match one of the accepted shapes. */
+export function parseClock(input: string): number {
+  const text = input.trim();
+  if (text === "") throw new SyntaxError(`invalid time: ${input}`);
+
+  const ampm = text.match(AMPM_RE);
+  if (ampm) {
+    const hours = Number(ampm[1]);
+    const minutes = ampm[2] === undefined ? 0 : Number(ampm[2]);
+    if (hours < 1 || hours > 12) throw new RangeError(`hours out of range: ${input}`);
+    if (minutes > 59) throw new RangeError(`minutes out of range: ${input}`);
+    // 12am -> 0, 12pm -> 12, rest shift pm by 12.
+    let hour24 = hours % 12;
+    if (ampm[3].toLowerCase() === "pm") hour24 += 12;
+    return hour24 * 60 + minutes;
+  }
+
+  const h24 = text.match(H24_RE);
+  if (h24) {
+    const hours = Number(h24[1]);
+    const minutes = Number(h24[2]);
+    if (hours > 23) throw new RangeError(`hours out of range: ${input}`);
+    if (minutes > 59) throw new RangeError(`minutes out of range: ${input}`);
+    return hours * 60 + minutes;
+  }
+
+  throw new SyntaxError(`invalid time: ${input}`);
+}
diff --git a/test/clock.test.ts b/test/clock.test.ts
index beca11e..4e8a5c3 100644
--- a/test/clock.test.ts
+++ b/test/clock.test.ts
@@ -1,6 +1,6 @@
 import { test } from "node:test";
 import assert from "node:assert/strict";
-import { formatClock } from "../src/clock.ts";
+import { formatClock, parseClock } from "../src/clock.ts";
 
 test("formatClock pads hours and minutes", () => {
   assert.equal(formatClock(0), "00:00");
@@ -10,3 +10,36 @@ test("formatClock pads hours and minutes", () => {
 test("formatClock rejects out-of-range minutes", () => {
   assert.throws(() => formatClock(1440), RangeError);
 });
+
+test("parseClock handles 24-hour times", () => {
+  assert.equal(parseClock("19:30"), 1170);
+  assert.equal(parseClock("7:05"), 425);
+  assert.equal(parseClock("00:00"), 0);
+  assert.equal(parseClock("23:59"), 1439);
+});
+
+test("parseClock handles 12-hour times", () => {
+  assert.equal(parseClock("7:30 pm"), 1170);
+  assert.equal(parseClock("7pm"), 1140);
+  assert.equal(parseClock("9 Am"), 540);
+  assert.equal(parseClock("12:15 am"), 15);
+  assert.equal(parseClock("12pm"), 720);
+  assert.equal(parseClock("12am"), 0);
+});
+
+test("parseClock ignores surrounding whitespace", () => {
+  assert.equal(parseClock("  7pm  "), 1140);
+  assert.equal(parseClock("\t19:30\n"), 1170);
+});
+
+test("parseClock throws RangeError for out-of-range numbers", () => {
+  for (const bad of ["24:00", "7:60", "13pm", "0am", "7:60pm"]) {
+    assert.throws(() => parseClock(bad), RangeError, bad);
+  }
+});
+
+test("parseClock throws SyntaxError for non-matching text", () => {
+  for (const bad of ["", "7", "7:5", "noon", "7:30 p.m."]) {
+    assert.throws(() => parseClock(bad), SyntaxError, bad);
+  }
+});
