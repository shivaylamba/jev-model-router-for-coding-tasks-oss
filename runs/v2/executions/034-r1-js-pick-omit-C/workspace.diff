diff --git a/src/object.js b/src/object.js
index 263bd36..207bd3b 100644
--- a/src/object.js
+++ b/src/object.js
@@ -19,3 +19,36 @@ export function mapValues(obj, fn) {
   for (const key of Object.keys(obj)) out[key] = fn(obj[key], key);
   return out;
 }
+
+/**
+ * A new object containing only the listed own enumerable keys of `obj`,
+ * in the order they appear in `keys`. Missing keys are ignored, as are
+ * inherited and non-enumerable properties. A key present with value
+ * `undefined` is kept.
+ * @param {Record<string, unknown>} obj
+ * @param {readonly string[]} keys
+ */
+export function pick(obj, keys) {
+  const out = {};
+  for (const key of keys) {
+    if (Object.prototype.propertyIsEnumerable.call(obj, key)) out[key] = obj[key];
+  }
+  return out;
+}
+
+/**
+ * A new object with every own enumerable string key of `obj` except those
+ * listed in `keys`, in the original key order. Listed keys that `obj`
+ * doesn't have are ignored. Inherited and non-enumerable properties are not
+ * copied.
+ * @param {Record<string, unknown>} obj
+ * @param {readonly string[]} keys
+ */
+export function omit(obj, keys) {
+  const excluded = new Set(keys);
+  const out = {};
+  for (const key of Object.keys(obj)) {
+    if (!excluded.has(key)) out[key] = obj[key];
+  }
+  return out;
+}
