+def _parse_value(token: str, field_idx: int) -> int:
+    """Parse a single number or name for the given field."""
+    token_lower = token.lower()
+    if field_idx == 3 and token_lower in _MONTH_NAMES:
+        return _MONTH_NAMES[token_lower]
+    if field_idx == 4 and token_lower in _WDAY_NAMES:
+        return _WDAY_NAMES[token_lower]
+    if not token.isdigit():
+        raise ValueError(f"invalid value {token!r}")
+    return int(token)
+
+
+def _parse_item(item: str, field_idx: int) -> set:
+    """Parse a single item (not a comma-separated list) into a set of valid values."""
+    lo, hi = _FIELD_RANGES[field_idx]
+
+    # Check for step
+    if '/' in item:
+        if item.count('/') != 1:
+            raise ValueError(f"invalid item {item!r}")
+        base, step_str = item.split('/')
+        if not step_str.isdigit() or step_str == '0':
+            raise ValueError(f"invalid step {step_str!r}")
+        step = int(step_str)
+    else:
+        base = item
+        step = 1
+
+    # Determine start/end
+    if base == '*':
+        start = lo
+        end = hi
+    elif '-' in base:
+        if base.count('-') != 1:
+            raise ValueError(f"invalid range {base!r}")
+        a_str, b_str = base.split('-')
+        start = _parse_value(a_str, field_idx)
+        end = _parse_value(b_str, field_idx)
+        if start > end:
+            raise ValueError(f"range start > end in {base!r}")
+    else:
+        start = _parse_value(base, field_idx)
+        end = hi if item.count('/') == 1 else start
+        if item.count('/') != 1:
+            end = start
+
+    # Validate range
+    if not (lo <= start <= hi):
+        raise ValueError(f"value {start} out of range for field {field_idx}")
+    if not (lo <= end <= hi):
+        raise ValueError(f"value {end} out of range for field {field_idx}")
+
+    result = set()
+    v = start
+    while v <= end:
+        result.add(v)
+        v += step
+    return result
+
+
+def _parse_field(text: str, field_idx: int) -> set:
+    """Parse a full field (comma-separated items) into a set of values."""
+    if not text:
+        raise ValueError("empty field")
+    items = text.split(',')
+    result = set()
+    for item in items:
+        if not item:
+            raise ValueError("empty item in field")
+        result |= _parse_item(item, field_idx)
+    return result
