+    # -- internals ---------------------------------------------------------
+
+    def _bucket(self, key):
+        bucket = self._buckets.get(key)
+        if bucket is None:
+            bucket = TokenBucket(self._rate, self._burst, self._clock)
+            self._buckets[key] = bucket
+        return bucket
+
+    def _grant_pass(self):
+        """Grant the eligible head whose acquire call came first, repeatedly."""
+        heads = []
+        for key, queue in self._queues.items():
+            if queue:
+                heads.append((queue[0].sequence, key))
+        for _, key in sorted(heads):
+            queue = self._queues[key]
+            if queue and self._eligible(key):
+                self._grant(queue[0])
+
+    def _grant(self, request):
+        self._bucket(request.key).try_take()
+        self._in_use += 1
+        request.granted = True
+        queue = self._queues[request.key]
+        queue.popleft()
+        if not queue:
+            del self._queues[request.key]
+        else:
+            # The new head must re-evaluate immediately: it may now start
+            # waiting for a token ("a request that becomes the head ... starts
+            # this wait right away").
+            self._wake(queue[0])
+        self._wake(request)
+
+    @staticmethod
+    def _wake(request):
+        if request.future is not None and not request.future.done():
+            request.future.set_result(None)
+
+    def _eligible(self, key):
+        return (
+            self._in_use < self._max_concurrent
+            and self._bucket(key).available() >= 1
+        )
+
+    def _start_token_wait(self, key):
+        """The head of `key` waits exactly the time until its next token.
+
+        The wait re-converges without polling when the sleep ends early: the
+        grant pass ends it if the request got away otherwise, and if the clock
+        has not advanced far enough acquire() sleeps again for the remaining
+        time.
+        """
+        future = asyncio.get_running_loop().create_future()
+
+        async def wait():
+            try:
+                await self._sleep(self._bucket(key).time_until_available())
+                self._grant_pass()
+            finally:
+                if not future.done():
+                    future.set_result(None)
+
+        task = asyncio.get_running_loop().create_task(wait())
+        future.add_done_callback(lambda _: task.cancel())
+        return future
+
+    def _undo_if_granted(self, request):
+        if request.granted:
+            self._in_use -= 1
+            self._buckets[request.key]._refill()
+            self._buckets[request.key]._tokens = min(
+                float(self._burst), self._buckets[request.key]._tokens + 1
+            )
+
+    def _remove(self, request):
+        queue = self._queues.get(request.key)
+        if queue is None:
+            return
+        if request not in queue:
+            return
+        was_head = queue[0] is request
+        queue.remove(request)
+        if not queue:
+            del self._queues[request.key]
+        elif was_head:
+            # The next request becomes the head and starts waiting for a
+            # token if needed; wake it so it re-evaluates right away.
+            self._wake(queue[0])
