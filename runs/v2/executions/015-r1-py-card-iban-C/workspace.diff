+def card_brand(number):
+    """Return the brand of card `number`: "visa", "mastercard", "amex" or "discover".
+
+    Spaces and hyphens are separators and are ignored; any other non-digit
+    character makes the number invalid. The digits must pass the Luhn checksum
+    and match a brand's prefix and length. Returns None for empty, invalid, or
+    Luhn-valid numbers that match no brand.
+    """
+    if not isinstance(number, str):
+        raise TypeError("number must be a string")
+    digits = strip_separators(number)
+    if not digits or not digits.isdigit() or not _luhn_valid(digits):
+        return None
+
+    length = len(digits)
+    if length == 15 and digits[:2] in ("34", "37"):
+        return "amex"
+    if length in (13, 16, 19) and digits.startswith("4"):
+        return "visa"
+    if length == 16 and (
+        digits[:2] in ("51", "52", "53", "54", "55")
+        or 2221 <= int(digits[:4]) <= 2720
+    ):
+        return "mastercard"
+    if length in (16, 19) and (
