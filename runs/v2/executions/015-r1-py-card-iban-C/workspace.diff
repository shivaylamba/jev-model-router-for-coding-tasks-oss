+def _luhn_valid(digits):
+    """Return True if `digits` (a string of digits) passes the Luhn checksum."""
+    total = 0
+    for i, ch in enumerate(reversed(digits)):
+        n = int(ch)
+        if i % 2 == 1:
+            n *= 2
+            if n > 9:
+                n -= 9
+        total += n
+    return total % 10 == 0
