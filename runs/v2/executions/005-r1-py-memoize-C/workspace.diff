+def memoize(func):
+    """Cache results per distinct set of arguments.
+
+    Re-running with the same arguments returns the cached value instead of
+    calling `func` again. Keyword arguments are matched regardless of order,
+    but positional and keyword forms of the same call are distinct entries.
+    `None` results are cached; raised exceptions propagate without caching.
+    """
+    cache = {}
+
+    @functools.wraps(func)
+    def wrapper(*args, **kwargs):
+        if kwargs:
+            key = (args, frozenset(kwargs.items()))
+        else:
+            key = (args, None)
+        try:
+            result = cache[key]
+        except KeyError:
+            wrapper.misses += 1
+            result = func(*args, **kwargs)
+            cache[key] = result
+            return result
+        wrapper.hits += 1
+        return result
+
+    def cache_info():
+        return CacheInfo(wrapper.hits, wrapper.misses, len(cache))
+
+    def cache_clear():
+        cache.clear()
+        wrapper.hits = 0
+        wrapper.misses = 0
+
+    wrapper.hits = 0
+    wrapper.misses = 0
+    wrapper.cache_info = cache_info
+    wrapper.cache_clear = cache_clear
+    return wrapper
