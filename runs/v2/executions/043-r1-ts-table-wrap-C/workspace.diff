+/** Greedily wrap a paragraph's words to column width `w`. */
+function wrap(words: string[], w: number): string[] {
+  const lines: string[] = [];
+  let cur = "";
+  let curW = 0;
+  for (const word of words) {
+    const wordW = widthOf(word);
+    if (wordW > w) {
+      // Word wider than the column: finish the line, then break the word.
+      if (curW > 0) {
+        lines.push(cur);
+        cur = "";
+        curW = 0;
+      }
+      const pieces = chunkWord(word, w);
+      for (let i = 0; i < pieces.length - 1; i++) lines.push(pieces[i]);
+      cur = pieces[pieces.length - 1];
+      curW = widthOf(cur);
+    } else if (curW === 0 || curW + 1 + wordW <= w) {
+      // Fits on the current line (with a leading space when non-empty).
+      if (curW > 0) {
