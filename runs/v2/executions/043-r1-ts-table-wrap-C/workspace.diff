+/** Split a paragraph into words on runs of U+0020; empty results are dropped. */
+function splitWords(paragraph: string): string[] {
+  return paragraph.split(/ +/).filter((s) => s.length > 0);
+}
+
+/**
+ * Cut a single word wider than `w` into chunks, each the longest prefix of the
+ * remaining code points that fits in `w`.
+ */
+function chunkWord(word: string, w: number): string[] {
+  const chunks: string[] = [];
+  let chunk = "";
+  let chunkW = 0;
+  for (const ch of word) {
+    const cw = widthOf(ch);
+    if (chunkW + cw > w) {
+      chunks.push(chunk);
+      chunk = ch;
+      chunkW = cw;
+    } else {
+      chunk += ch;
+      chunkW += cw;
+    }
+  }
+  chunks.push(chunk);
+  return chunks;
+}
