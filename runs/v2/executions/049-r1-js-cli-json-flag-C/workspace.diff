diff --git a/test/cli.test.js b/test/cli.test.js
index ca3e4d4..f56ec42 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -36,3 +36,36 @@ test("unknown option", () => {
   assert.equal(run(["-x"], io), 2);
   assert.equal(io.out, "");
 });
+
+test("json single file", () => {
+  const io = fakeIo({ "a.txt": "hello world\n" });
+  assert.equal(run(["--json", "a.txt"], io), 0);
+  assert.equal(io.out, '{"files":[{"path":"a.txt","lines":1,"words":2,"chars":12}],"total":{"lines":1,"words":2,"chars":12}}\n');
+  assert.equal(io.err, "");
+});
+
+test("json flag may appear after a file and anywhere among args", () => {
+  const io = fakeIo({ "a.txt": "a b\n", "b.txt": "c\n" });
+  assert.equal(run(["a.txt", "--json", "b.txt"], io), 0);
+  assert.equal(
+    io.out,
+    '{"files":[{"path":"a.txt","lines":1,"words":2,"chars":4},{"path":"b.txt","lines":1,"words":1,"chars":2}],"total":{"lines":2,"words":3,"chars":6}}\n',
+  );
+});
+
+test("json with no files", () => {
+  const io = fakeIo({});
+  assert.equal(run(["--json"], io), 0);
+  assert.equal(io.out, '{"files":[],"total":{"lines":0,"words":0,"chars":0}}\n');
+  assert.equal(io.err, "");
+});
+
+test("json with an unreadable file omits it and exits 1", () => {
+  const io = fakeIo({ "a.txt": "a b\n" });
+  assert.equal(run(["a.txt", "nope.txt", "--json", "b.txt"], io), 1);
+  assert.equal(
+    io.out,
+    '{"files":[{"path":"a.txt","lines":1,"words":2,"chars":4}],"total":{"lines":1,"words":2,"chars":4}}\n',
+  );
+  assert.equal(io.err, "tally: cannot read nope.txt\ntally: cannot read b.txt\n");
+});
