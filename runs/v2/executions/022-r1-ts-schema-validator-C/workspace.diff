+  assert.deepEqual(validate({ pattern: "a" }, [1, 2]), []);
+  assert.deepEqual(validate({ minimum: 0 }, "x"), []);
+  assert.deepEqual(validate({ maximum: 0 }, "x"), []);
+  assert.deepEqual(validate({ exclusiveMinimum: 0 }, "x"), []);
+  assert.deepEqual(validate({ exclusiveMaximum: 0 }, "x"), []);
+  assert.deepEqual(validate({ enum: [1, 2] }, "x"), [{ path: "", keyword: "enum" }]);
+  assert.deepEqual(validate({ const: 1 }, "x"), [{ path: "", keyword: "const" }]);
+});
+
+test("properties and additionalProperties together", () => {
+  const schema = {
+    properties: {
+      known: { type: "string" },
