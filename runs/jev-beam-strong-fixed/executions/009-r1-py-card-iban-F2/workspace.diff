+def is_valid_iban(iban):
+    """True if `iban` passes the country/length and mod-97 checks."""
+    if not isinstance(iban, str):
+        raise TypeError("iban must be a str")
+    compact = iban.replace(" ", "")
+    # After removing spaces: only letters and digits may remain.
+    if not compact.isalnum() or len(compact) < 5:
+        return False
+    if not (compact[0].isalpha() and compact[1].isalpha()):
+        return False
+    if not (compact[2].isdigit() and compact[3].isdigit()):
+        return False
+    country = compact[:2].upper()
+    if IBAN_LENGTHS.get(country) != len(compact):
+        return False
+    rearranged = compact[4:] + compact[:4]
+    number = "".join(
+        ch if ch.isdigit() else str(ord(ch.upper()) - ord("A") + 10)
+        for ch in rearranged
+    )
+    return int(number) % 97 == 1
