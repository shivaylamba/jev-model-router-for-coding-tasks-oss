+def _luhn_valid(digits):
+    """True if the digit string passes the Luhn checksum."""
+    total = 0
+    for i, ch in enumerate(reversed(digits)):
+        d = int(ch)
+        if i % 2 == 1:  # double every second digit from the right
+            d *= 2
+            if d > 9:
+                d -= 9
+        total += d
+    return total % 10 == 0
+
+
+def card_brand(number):
+    """Return the card brand as a string, or None if not a recognized card.
+
+    Spaces and hyphens are ignored; any other non-digit character, a failed
+    Luhn checksum, or a prefix/length that matches no brand yields None.
+    """
+    if not isinstance(number, str):
+        raise TypeError("card number must be a str")
+    digits = strip_separators(number)
+    if not digits or not digits.isdigit() or not _luhn_valid(digits):
+        return None
+    n = len(digits)
+    if digits[:2] in ("34", "37") and n == 15:
+        return "amex"
+    if digits[0] == "4" and n in (13, 16, 19):
+        return "visa"
+    if ("51" <= digits[:2] <= "55" or "2221" <= digits[:4] <= "2720") and n == 16:
+        return "mastercard"
+    if (digits.startswith("6011") or digits.startswith("65")
+            or digits[:3] in ("644", "645", "646", "647", "648", "649")) and n in (16, 19):
+        return "discover"
+    return None
+
