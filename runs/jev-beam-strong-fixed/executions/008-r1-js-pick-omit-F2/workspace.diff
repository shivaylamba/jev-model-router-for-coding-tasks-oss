+
+/**
+ * A new object with only the given keys that are own enumerable properties of `obj`,
+ * kept in the order they appear in `keys`. Missing, inherited and non-enumerable
+ * keys are ignored.
+ * @param {Record<string, unknown>} obj
+ * @param {string[]} keys
+ */
+export function pick(obj, keys) {
+  const out = {};
+  for (const key of keys) {
+    const desc = Object.getOwnPropertyDescriptor(obj, key);
+    if (desc && desc.enumerable) out[key] = obj[key];
+  }
+  return out;
+}
+
+/**
+ * A new object with every own enumerable string key of `obj` except the given ones,
+ * kept in the original order.
+ * @param {Record<string, unknown>} obj
+ * @param {string[]} keys
+ */
+export function omit(obj, keys) {
+  const toOmit = new Set(keys);
+  const out = {};
+  for (const key of Object.keys(obj)) {
+    if (!toOmit.has(key)) out[key] = obj[key];
+  }
+  return out;
+}
