 """Cron expression evaluation. The supported syntax is described in SPEC.md."""
 
+import calendar
+import re
 from datetime import datetime
 
+_MACROS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {
+    "jan": 1, "feb": 2, "mar": 3, "apr": 4, "may": 5, "jun": 6,
+    "jul": 7, "aug": 8, "sep": 9, "oct": 10, "nov": 11, "dec": 12,
+}
+
+_DOW_NAMES = {
+    "sun": 0, "mon": 1, "tue": 2, "wed": 3, "thu": 4, "fri": 5, "sat": 6,
+}
+
+_FIELD_MIN = [0, 0, 1, 1, 0]
+_FIELD_MAX = [59, 23, 31, 12, 7]
+
+
+def _parse_number(token: str, field_idx: int) -> int:
+    token_lower = token.lower()
+    if field_idx == 3 and token_lower in _MONTH_NAMES:
+        return _MONTH_NAMES[token_lower]
+    if field_idx == 4 and token_lower in _DOW_NAMES:
+        return _DOW_NAMES[token_lower]
+    if not token.isdigit():
+        raise ValueError(f"invalid value {token!r}")
+    n = int(token)
+    lo, hi = _FIELD_MIN[field_idx], _FIELD_MAX[field_idx]
+    if not (lo <= n <= hi):
+        raise ValueError(f"value {n} out of range")
+    return n
+
+
+def _parse_item(item: str, field_idx: int) -> set:
+    if not item:
+        raise ValueError("empty item")
+
+    if "/" in item:
+        base, step_str = item.split("/", 1)
+        if not step_str.isdigit():
+            raise ValueError(f"invalid step {step_str!r}")
+        step = int(step_str)
+        if step <= 0:
+            raise ValueError("step must be positive")
+    else:
+        base = item
+        step = 1
+
+    lo, hi = _FIELD_MIN[field_idx], _FIELD_MAX[field_idx]
+
+    if base == "*":
+        start, end = lo, hi
+    elif "-" in base:
+        a_str, b_str = base.split("-", 1)
+        start = _parse_number(a_str, field_idx)
+        end = _parse_number(b_str, field_idx)
+        if start > end:
+            raise ValueError(f"range start {start} > end {end}")
+    else:
+        start = _parse_number(base, field_idx)
+        if step == 1:
+            return {start}
+        end = hi
+
+    return set(range(start, end + 1, step))
+
+
+def _parse_field(text: str, field_idx: int) -> set:
+    if not text:
+        raise ValueError("empty field")
+    values = set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item in list")
+        values.update(_parse_item(item, field_idx))
+    return values
+
+
+def _parse(expr: str):
+    expr = expr.strip()
+
+    if expr.startswith("@"):
+        macro = expr.lower()
+        if macro not in _MACROS:
+            raise ValueError(f"unknown macro {expr!r}")
+        expr = _MACROS[macro]
+
+    fields_raw = re.split(r"[ \t]+", expr.strip())
+    if len(fields_raw) != 5:
+        raise ValueError(f"expected 5 fields, got {len(fields_raw)}")
+
+    parsed = [_parse_field(f, i) for i, f in enumerate(fields_raw)]
+
+    dom_restricted = not fields_raw[2].startswith("*")
+    dow_restricted = not fields_raw[4].startswith("*")
+
+    return parsed, dom_restricted, dow_restricted
+
+
+def _days_in_month(year: int, month: int) -> int:
+    return calendar.monthrange(year, month)[1]
+
+
+def _dow_to_cron(dt: datetime) -> int:
+    # Monday=0..Sunday=6 -> cron Sunday=0..Saturday=6
+    return (dt.weekday() + 1) % 7
+
 
