 """Orders and their lifecycle."""
 
+import datetime
+import typing
+
+
+class InvalidTransition(Exception):
+    """Raised when an event is not allowed from the current status."""
+
+    def __init__(self, state, event):
+        self.state = state
+        self.event = event
+        super().__init__(f"Event '{event}' is not allowed from state '{state}'")
+
+
+class Transition(typing.NamedTuple):
+    """A record of a successful state transition."""
+
+    event: str
+    from_state: str
+    to_state: str
+    at: datetime.datetime
+
+
+_TRANSITIONS = {
+    "pay": {"pending"},
+    "pack": {"paid"},
+    "ship": {"packed"},
+    "deliver": {"shipped"},
+    "cancel": {"pending", "paid", "packed"},
+    "refund": {"paid", "packed", "delivered"},
+}
+
+_TERMINAL_STATES = {"cancelled", "refunded"}
+
+_REFUND_WINDOW_DAYS = 30
+
+
+def _utc_now():
+    """Return the current time as a timezone-aware UTC datetime."""
+    return datetime.datetime.now(datetime.timezone.utc)
+
+
+def _is_empty_string(value):
+    """Return True if value is not a string or is empty/whitespace only."""
+    return not isinstance(value, str) or not value.strip()
+
 
