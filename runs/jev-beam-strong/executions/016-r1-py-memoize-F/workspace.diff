+def memoize(func):
+    """Cache `func`'s return value per distinct set of arguments."""
+    cache = {}
+    hits = 0
+    misses = 0
+
+    def key(*args, **kwargs):
+        if kwargs:
+            items = tuple(sorted(kwargs.items()))
+            return (*args, items)
+        return args
+
+    @functools.wraps(func)
+    def wrapper(*args, **kwargs):
+        nonlocal hits, misses
+        try:
+            result = cache[key(*args, **kwargs)]
+        except TypeError:
+            # Unhashable argument: the function is never called.
+            raise
+        except KeyError:
+            # Miss: call the function and store its result.
+            misses += 1
+            result = func(*args, **kwargs)
+            cache[key(*args, **kwargs)] = result
+            return result
+        hits += 1
+        return result
+
+    def cache_info():
+        return CacheInfo(hits, misses, len(cache))
+
+    def cache_clear():
+        nonlocal hits, misses
+        cache.clear()
+        hits = 0
+        misses = 0
+
+    wrapper.cache_info = cache_info
+    wrapper.cache_clear = cache_clear
+    return wrapper
