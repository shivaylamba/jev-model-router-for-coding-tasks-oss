+export function readConfig(path: string, callback?: ConfigCallback): Promise<Config> | void {
+  const promise = new Promise<Config>((resolve, reject) => {
+    readFile(path, "utf8", (err, text) => {
+      if (err) {
+        reject(err);
+        return;
+      }
+      let config: Config;
+      try {
+        config = applyDefaults(JSON.parse(text));
+      } catch (parseErr) {
+        reject(parseErr as Error);
+        return;
+      }
+      resolve(config);
+    });
   });
+
+  if (callback) {
+    promise.then(
+      (config) => callback(null, config),
+      (err) => callback(err as Error),
+    );
+    return;
+  }
+
+  return promise;
 }
