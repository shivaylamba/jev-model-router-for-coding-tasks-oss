 """Orders and their lifecycle."""
+from datetime import datetime, timedelta, timezone
+import typing
 
+class InvalidTransition(Exception):
+    def __init__(self, state, event):
+        super().__init__(f"cannot {event} from {state}")
+        self.state = state
+        self.event = event
+
+class Transition(typing.NamedTuple):
+    event: str
+    from_state: str
+    to_state: str
+    at: datetime
+
+def _default_clock():
+    return datetime.now(timezone.utc)
+
+_TRANSITIONS = {
+    "pay": {"from": {"pending"}, "to": "paid"},
+    "pack": {"from": {"paid"}, "to": "packed"},
+    "ship": {"from": {"packed"}, "to": "shipped"},
+    "deliver": {"from": {"shipped"}, "to": "delivered"},
+    "cancel": {"from": {"pending", "paid", "packed"}, "to": "cancelled"},
+    "refund": {"from": {"paid", "packed", "delivered"}, "to": "refunded"},
+}
+
+TERMINAL = {"cancelled", "refunded"}
 
