+        return self.status in t["from"]
+
+    def can(self, event):
+        return self._check_allowed(event)
+
+    def allowed_events(self):
+        return sorted(e for e in _TRANSITIONS if self._check_allowed(e))
+
+    def _do_transition(self, event, to_state):
+        if not self._check_allowed(event):
+            raise InvalidTransition(self.status, event)
+        from_state = self.status
+        at = self.clock()
+        self.status = to_state
+        if event == "deliver":
+            self.delivered_at = at
+        self.history.append(Transition(event=event, from_state=from_state, to_state=to_state, at=at))
+
