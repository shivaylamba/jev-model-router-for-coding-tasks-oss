+def is_valid_iban(iban):
+    """Return True if `iban` is a valid IBAN, False otherwise."""
+    if not isinstance(iban, str):
+        raise TypeError("iban must be a str")
+
+    cleaned = iban.replace(" ", "")
+    if len(cleaned) < 4:
+        return False
+
+    country_code = cleaned[:2]
+    check_digits = cleaned[2:4]
+    rest = cleaned[4:]
+
+    if len(country_code) != 2 or not country_code.isascii() or not all(c in string.ascii_letters for c in country_code):
+        return False
+    if len(check_digits) != 2 or not check_digits.isascii() or not all(c in string.digits for c in check_digits):
+        return False
+    if not rest.isascii():
+        return False
+    for ch in rest:
+        if not (ch in string.ascii_letters or ch in string.digits):
+            return False
+
+    country = country_code.upper()
+    if country not in IBAN_LENGTHS:
+        return False
+    if len(cleaned) != IBAN_LENGTHS[country]:
+        return False
+
+    rearranged = cleaned[4:] + cleaned[:4]
+    converted = []
+    for ch in rearranged:
+        if ch in string.ascii_letters:
+            converted.append(str(ord(ch.upper()) - ord("A") + 10))
+        else:
+            converted.append(ch)
+    numeric = "".join(converted)
+    if not numeric.isdigit():
+        return False
+    return int(numeric) % 97 == 1
