+def card_brand(number):
+    """Return the card brand for a number, or None if it is not a valid card."""
+    if not isinstance(number, str):
+        raise TypeError("number must be a str")
+    if number == "":
+        return None
+
+    for ch in number:
+        if ch not in " -" and not (ch in string.digits):
+            return None
+
+    digits = strip_separators(number, " -")
+    if digits == "" or not (digits.isascii() and digits.isdigit()):
+        return None
+    if not _luhn_valid(digits):
+        return None
+
+    length = len(digits)
+
+    if length == 15 and (digits.startswith("34") or digits.startswith("37")):
+        return "amex"
+    if digits.startswith("4") and length in (13, 16, 19):
+        return "visa"
+    if length == 16:
+        first_two = int(digits[:2])
+        first_four = int(digits[:4])
+        if 51 <= first_two <= 55 or 2221 <= first_four <= 2720:
+            return "mastercard"
+    if length in (16, 19):
+        if digits.startswith("6011"):
+            return "discover"
+        if digits.startswith("65"):
+            return "discover"
+        if length >= 3:
+            try:
+                first_three = int(digits[:3])
+            except ValueError:
+                first_three = -1
+            if 644 <= first_three <= 649:
+                return "discover"
+
+    return None
+
