+            end = hi
+        elif "-" in base:
+            a_str, b_str = base.split("-", 1)
+            if "-" in b_str:
+                raise ValueError("invalid range")
+            a = _parse_value(a_str, names, lo, hi)
+            b = _parse_value(b_str, names, lo, hi)
+            if a > b:
+                raise ValueError("range start greater than end")
+            start = a
+            end = b
+        else:
+            v = _parse_value(base, names, lo, hi)
+            start = v
+            if step is None:
