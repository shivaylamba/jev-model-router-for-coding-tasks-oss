+def _parse_field(text, lo, hi, names):
+    unrestricted = text.startswith("*")
+    items = text.split(",")
+    if any(i == "" for i in items):
+        raise ValueError("empty item")
+    result = set()
+    for item in items:
+        if "/" in item:
+            base, step_str = item.split("/", 1)
+            # disallow extra slashes
+            if "/" in step_str:
+                raise ValueError("invalid item")
+            step = _parse_step(step_str)
+        else:
+            base = item
+            step = None
+
+        if base == "*":
