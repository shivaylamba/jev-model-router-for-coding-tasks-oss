+def _parse_step(tok):
+    if not tok:
+        raise ValueError("empty step")
+    try:
+        s = int(tok, 10)
+    except (TypeError, ValueError):
+        raise ValueError(f"invalid step {tok!r}")
+    if s <= 0:
+        raise ValueError("step must be positive")
+    return s
+
