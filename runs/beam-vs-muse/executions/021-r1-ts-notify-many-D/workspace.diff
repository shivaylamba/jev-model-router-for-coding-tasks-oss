   }
 
   /**
-   * Send `message` to one recipient. The recipient is trimmed before sending.
-   * Throws TypeError if the recipient is empty or only whitespace.
+   * Send `message` to one or more recipients. A single string behaves as before;
+   * an array sends to each recipient in order. Recipients are trimmed before
+   * sending. Duplicates (case-insensitive after trimming) are sent only once,
+   * using the first spelling. Throws TypeError if any recipient is blank, before
+   * sending anything. Returns the number of messages actually sent.
    */
-  notify(recipient: string, message: string): void {
-    const to = recipient.trim();
-    if (to === "") {
-      throw new TypeError("recipient must be a non-empty string");
+  notify(recipients: string | readonly string[], message: string): number {
+    if (typeof recipients === "string") {
+      const to = recipients.trim();
+      if (to === "") {
+        throw new TypeError("recipient must be a non-empty string");
+      }
+      this.transport.send(to, message);
+      return 1;
     }
-    this.transport.send(to, message);
+
+    const trimmed = recipients.map((recipient) => recipient.trim());
+    for (const to of trimmed) {
+      if (to === "") {
+        throw new TypeError("recipient must be a non-empty string");
+      }
+    }
+
+    const seen = new Set<string>();
+    let sent = 0;
+    for (const to of trimmed) {
+      const key = to.toLowerCase();
+      if (seen.has(key)) continue;
+      seen.add(key);
+      this.transport.send(to, message);
+      sent++;
+    }
+    return sent;
   }
