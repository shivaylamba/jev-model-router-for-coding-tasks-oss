+def _encode(s: str) -> str:
+    # UTF-8 percent-encode with uppercase hex; unreserved: A-Z a-z 0-9 - . _ ~ left as-is, space -> "+"
+    # First handle: encode string to utf-8 bytes, then for each byte decide
+    out = []
+    for b in s.encode('utf-8'):
+        c = chr(b)
+        if c == ' ':
+            out.append('+')
+        elif c in 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~':
+            out.append(c)
+        else:
+            out.append(f'%{b:02X}')
+    return ''.join(out)
