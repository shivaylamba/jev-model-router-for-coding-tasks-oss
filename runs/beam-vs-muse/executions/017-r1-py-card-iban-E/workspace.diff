+def card_brand(number):
+    if not isinstance(number, str):
+        raise TypeError("card number must be str")
+    if number == "":
+        return None
+    # Validate characters: only digits, space, hyphen allowed
+    for ch in number:
+        if ch not in "0123456789 -":
+            return None
+    digits = strip_separators(number)
+    if digits == "" or not digits.isdigit():
+        return None
+    if not _luhn_valid(digits):
+        return None
+    n = len(digits)
+    # amex: 34/37, 15 digits
+    if n == 15 and digits[:2] in ("34", "37"):
+        return "amex"
+    # visa: starts with 4, 13/16/19 digits
+    if digits[0] == "4" and n in (13, 16, 19):
+        return "visa"
+    # mastercard: 51-55 or 2221-2720, 16 digits
+    if n == 16:
+        first2 = int(digits[:2])
+        first4 = int(digits[:4])
+        if (51 <= first2 <= 55) or (2221 <= first4 <= 2720):
+            return "mastercard"
+    # discover: 6011, 65, 644-649, 16 or 19 digits
+    if n in (16, 19):
+        if digits.startswith("6011") or digits.startswith("65"):
+            return "discover"
+        if len(digits) >= 3:
+            p3 = int(digits[:3])
+            if 644 <= p3 <= 649:
+                return "discover"
+    return None
+
