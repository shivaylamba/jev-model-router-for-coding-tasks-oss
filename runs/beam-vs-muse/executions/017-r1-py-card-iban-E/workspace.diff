+def is_valid_iban(iban):
+    if not isinstance(iban, str):
+        raise TypeError("IBAN must be str")
+    # Any separator other than space makes invalid (check original string)
+    # Spaces are ignored; letters may be any case.
+    # If any character other than alnum or space, invalid.
+    for ch in iban:
+        if ch == " ":
+            continue
+        if not ch.isalnum():
+            return False
+    compact = iban.replace(" ", "")
+    if len(compact) < 4:
+        return False
+    # Must be CC + DD + alnum
+    if not (compact[0].isalpha() and compact[1].isalpha()):
+        return False
+    if not (compact[2].isdigit() and compact[3].isdigit()):
+        return False
+    # Rest must be alnum (already ensured no non-alnum except spaces removed, but check)
+    if not compact.isalnum():
+        return False
+    country = compact[:2].upper()
+    if country not in IBAN_LENGTHS:
+        return False
+    if len(compact) != IBAN_LENGTHS[country]:
+        return False
+    # mod-97 check
+    rearranged = compact[4:] + compact[:4]
+    rearranged = rearranged.upper()
+    numeric_str = ""
+    for ch in rearranged:
+        if ch.isdigit():
+            numeric_str += ch
+        else:
+            numeric_str += str(ord(ch) - 55)  # A=10
+    # Iterative mod to avoid huge int (though Python handles it)
+    remainder = 0
+    for ch in numeric_str:
+        remainder = (remainder * 10 + (ord(ch) - 48)) % 97
+    return remainder == 1
