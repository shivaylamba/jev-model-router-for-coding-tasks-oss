+            } catch (err) {
+              throw new PluginError(plugin.name, "beforeRender", err);
+            }
+            if (result === undefined) {
+              // keep
+            } else if (result !== null && typeof result === "object") {
+              currentPage = result;
+            } else {
+              throw new PluginError(
+                plugin.name,
+                "beforeRender",
+                new TypeError("beforeRender must return an object or undefined"),
+              );
+            }
+          }
