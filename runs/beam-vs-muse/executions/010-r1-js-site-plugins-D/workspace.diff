+export class PluginError extends Error {
+  constructor(plugin, hook, cause) {
+    super(`Plugin "${plugin}" threw during "${hook}"`);
+    this.name = "PluginError";
+    this.plugin = plugin;
+    this.hook = hook;
+    this.cause = cause;
+  }
+}
+
+const HOOKS = ["beforeRender", "afterRender", "onComplete"];
+
+function validatePlugin(plugin) {
+  if (typeof plugin !== "object" || plugin === null) {
+    throw new TypeError("plugin must be an object");
+  }
+  if (typeof plugin.name !== "string" || plugin.name === "") {
+    throw new TypeError("plugin name must be a non-empty string");
+  }
+  for (const hook of HOOKS) {
+    if (plugin[hook] !== undefined && typeof plugin[hook] !== "function") {
+      throw new TypeError(`plugin hook ${hook} must be a function`);
+    }
+  }
+}
+
+export function createSite(options) {
+  const { layout = defaultLayout } = options || {};
+  const plugins = [];
+  const names = new Set();
+
+  const site = {
+    use(plugin) {
+      validatePlugin(plugin);
+      if (names.has(plugin.name)) {
+        throw new Error(`Plugin "${plugin.name}" is already registered`);
+      }
+      plugins.push(plugin);
+      names.add(plugin.name);
+      return site;
+    },
+    async build(pages) {
+      const outputs = new Map();
+      for (const page of pages) {
+        // beforeRender
+        const beforePlugins = plugins.filter((p) => typeof p.beforeRender === "function");
+        let currentPage;
+        if (beforePlugins.length > 0) {
+          currentPage = { ...page };
+          for (const plugin of beforePlugins) {
+            let result;
+            try {
